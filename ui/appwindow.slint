// ==============================================================================
// BLI-RS 主视窗容器 (Main App Window)
//
// ==============================================================================
// 手势架构（重写版）
// ==============================================================================
//
// 旧结构：在页面区盖一个全屏 TouchArea，靠坐标反推命中哪张卡。
// 它导出了三个无法局部修补的病灶：
//
//   1. 全屏层拿走 press，卡片内任何 TouchArea 都收不到 down。
//      评论 Tab 点不动、卡片直接点击失效 —— 只能 tap_at(x,y) 反推行列。
//   2. 反推公式假设"坐标 = 内容坐标"，但列表滚动过 / 页面横移过之后
//      这两个坐标系就不重合了，命中必然错位。
//   3. 按压反馈、滑动取消、抬手命中是三套手工同步的状态，必然错位。
//
// 新结构：**没有任何覆盖层**。谁被按下谁处理，pan 沿组件树往上冒泡。
//
//   VideoCard.GestureArea ──tap──→ 打开视频
//                         ──pan──→ RecommendView（只转横向）
//                                     ↓ swipe_horizontal
//                                  AppWindow 切频道
//
//   纵向滚动由 RecommendView 内部的 Flickable 直接接管，
//   因为内容宽度 == 视口宽度，横轴"没得滚"，横向分量不会被它捕获，
//   所以横滑能顺利冒泡上来。两条路天然互不干扰。
//
// Tab 切换数据流：
//   tab_index（离散值）→ 页面位移，只在这一个地方写。
//   手势与 Tab 点击都走 go_tab_animated。
//
// 二级页面（视频详情）：
//   独立一层，盖满整屏，自己处理返回手势与滚动。
//   **不由 AppWindow 代管** —— 两个页面的手势语义完全不同。
// ==============================================================================

import { Theme, UiMetrics, NavTabType, VideoItemData, VideoRowPair, VideoDetailData, RelatedVideoData, CommentItemData, Spacing } from "theme.slint";
import { TopBar } from "components/topbar.slint";
import { NavigationDrawer } from "components/drawer.slint";
import { RecommendView } from "views/recommend_view.slint";
import { LiveView } from "views/live_view.slint";
import { FollowView } from "views/follow_view.slint";
import { VideoDetailView } from "views/video_detail_view.slint";
import { PageSwipeArea } from "components/page_swipe.slint";

export component AppWindow inherits Window {
    title: "Bli-RS";

    // 由 Rust 侧在启动时调用一次：把当前明暗色板写进 Theme。
    public function apply_palette() {
        Theme.dark = root.pal_dark;
        Theme.background = root.pal_background;
        Theme.surface = root.pal_surface;
        Theme.surface_container = root.pal_surface_container;
        Theme.surface_container_high = root.pal_surface_container_high;
        Theme.surface_variant = root.pal_surface_variant;
        Theme.search_bg = root.pal_search_bg;
        Theme.on_surface = root.pal_on_surface;
        Theme.on_surface_variant = root.pal_on_surface_variant;
        Theme.outline = root.pal_outline;
        Theme.outline_variant = root.pal_outline_variant;
        Theme.primary = root.pal_primary;
        Theme.on_primary = root.pal_on_primary;
        Theme.primary_container = root.pal_primary_container;
        Theme.on_primary_container = root.pal_on_primary_container;
        Theme.secondary = root.pal_secondary;
        Theme.secondary_container = root.pal_secondary_container;
        Theme.scrim = root.pal_scrim.transparentize(Theme.dark ? 55% : 40%);
    }

    in-out property <color> pal_background: Theme.background;
    in-out property <color> pal_surface: Theme.surface;
    in-out property <color> pal_surface_container: Theme.surface_container;
    in-out property <color> pal_surface_container_high: Theme.surface_container_high;
    in-out property <color> pal_surface_variant: Theme.surface_variant;
    in-out property <color> pal_search_bg: Theme.search_bg;
    in-out property <color> pal_on_surface: Theme.on_surface;
    in-out property <color> pal_on_surface_variant: Theme.on_surface_variant;
    in-out property <color> pal_outline: Theme.outline;
    in-out property <color> pal_outline_variant: Theme.outline_variant;
    in-out property <color> pal_primary: Theme.primary;
    in-out property <color> pal_on_primary: Theme.on_primary;
    in-out property <color> pal_primary_container: Theme.primary_container;
    in-out property <color> pal_on_primary_container: Theme.on_primary_container;
    in-out property <color> pal_secondary: Theme.secondary;
    in-out property <color> pal_secondary_container: Theme.secondary_container;
    in-out property <color> pal_scrim: #000000;
    in-out property <bool> pal_dark: Theme.dark;

    preferred-width: 390px;
    preferred-height: 844px;
    background: Theme.background;

    // --------------------------------------------------------------------------
    // 状态
    // --------------------------------------------------------------------------
    in-out property <NavTabType> current_tab: NavTabType.Recommend;
    in-out property <bool> drawer_open: false;
    callback drawer_changed();

    // 状态栏与导航栏安全边距（注入保底与系统实测值）
    in-out property <length> status_bar_height: 0px;
    property <length> safe_top: Math.max(Math.max(root.safe-area-insets.top, root.status_bar_height), 24px);
    property <length> safe_bottom: root.safe-area-insets.bottom;

    // 把手势原语需要的窗口级度量灌进 UiMetrics（见 theme.slint）。
    //
    // system_bottom_guard 取 safe_bottom 与 32px 的较大者：
    // 手势导航下 safe_bottom 通常就是那条"上滑回桌面"的把手高度，
    // 落在这一条带里的起手，GestureArea 直接不接管，全部留给系统。
    property <length> guard_bottom: Math.max(root.safe_bottom, 32px);

    init => {
        UiMetrics.window_height = root.height;
        UiMetrics.system_bottom_guard = root.guard_bottom;
    }
    changed height => {
        UiMetrics.window_height = root.height;
    }
    changed guard_bottom => {
        UiMetrics.system_bottom_guard = root.guard_bottom;
    }

    property <int> tab_index:
        (root.current_tab == NavTabType.Live) ? 0
        : (root.current_tab == NavTabType.Recommend) ? 1 : 2;

    property <int> page_count: 3;

    property <length> page_base: -(root.tab_index * page_area.width);
    property <length> swipe_dx: 0px;
    property <bool> animating: false;

    in-out property <length> g_pull: 0px;
    in-out property <bool> g_refreshing: false;

    // --------------------------------------------------------------------------
    // 推荐流数据
    // --------------------------------------------------------------------------
    in-out property <[VideoRowPair]> rows: [];
    in-out property <int> feed_state: 0;
    in-out property <string> feed_error: "";
    in-out property <bool> has_more: true;
    in-out property <bool> loading_more: false;
    in-out property <string> more_error: "";

    callback play_video(string);
    callback video_long_pressed(string);
    callback refresh_feed();
    callback load_more();
    callback open_search();
    callback open_message();

    // 0 = 推荐主页, 1 = 视频详情播放页
    in-out property <int> app_mode: 0;
    in-out property <VideoDetailData> current_detail;
    in-out property <[RelatedVideoData]> related_videos: [];
    in-out property <[CommentItemData]> video_comments: [];

    callback exit_detail_view();
    callback toggle_like();
    callback toggle_coin();
    callback toggle_fav();

    in-out property <int> unread_count: 1;

    // --------------------------------------------------------------------------
    // 系统返回键
    //
    // android-activity 把 Keycode.Back 映射成 Key.Back 交给 Slint
    // （androidwindowadapter.rs 的 map_key_code）。如果没人 accept，
    // 它就返回 InputStatus::Unhandled → android-activity 走 fallback → finish 掉
    // NativeActivity → App 直接退出。
    //
    // 所以这里必须有一个能接住它的 FocusScope，并按栈序逐层消费：
    //   抽屉打开   → 关抽屉
    //   详情页     → 回首页
    //   否则       → reject，交还系统（正常退出）
    //
    // 注意：FocusScope 不消费指针事件（它只在 focus-on-click 时处理 press），
    // 所以铺满全屏也不会影响下面任何手势。
    // --------------------------------------------------------------------------
    forward-focus: key_handler;

    key_handler := FocusScope {
        // key-pressed 的返回值是 EventResult：accept / reject。
        // Slint 里 callback 的返回值是**最后一个表达式**，不能写 `return accept;`，
        // 所以这里用条件表达式一次性给出结论。
        key-pressed(event) => {
            // 抽屉优先：ESC / 返回都先关抽屉
            if (root.drawer_open && (event.text == Key.Escape || event.text == Key.Back)) {
                root.drawer_open = false;
                root.drawer_changed();
                accept
            } else if (root.app_mode == 1 && (event.text == Key.Escape || event.text == Key.Back)) {
                // 详情页：返回首页
                root.app_mode = 0;
                root.exit_detail_view();
                accept
            } else {
                // 首页的返回交给系统 —— 与前身一致，返回键退出 App
                reject
            }
        }
    }


    // --------------------------------------------------------------------------
    // Tab 切换
    // --------------------------------------------------------------------------
    function go_tab_animated(next: int) {
        if (next < 0 || next > 2) { return; }
        root.current_tab =
            (next == 0) ? NavTabType.Live
            : (next == 1) ? NavTabType.Recommend
            : NavTabType.Follow;
        root.animating = true;
        root.page_base = -(next * page_area.width);
        root.swipe_dx = 0px;
        anim_reset.start();
    }

    anim_reset := Timer {
        interval: Theme.animation_duration_tab + 40ms;
        running: false;
        triggered => {
            root.animating = false;
            root.page_base = -(root.tab_index * page_area.width);
            root.swipe_dx = 0px;
        }
    }

    // --------------------------------------------------------------------------
    // 横滑切频道
    //
    // 语义对齐官方：左滑下一个频道，右滑上一个频道。
    // 已经在最左还右滑 → 40% 阻尼（"墙"），不触发抽屉。
    // 抽屉唯一入口是左上角头像（见 ADR 4.4：系统手势区抢不走它）。
    // --------------------------------------------------------------------------
    function apply_swipe(dx: length) {
        let at_left = (root.tab_index == 0 && dx > 0px);
        let at_right = (root.tab_index == root.page_count - 1 && dx < 0px);
        root.swipe_dx = (at_left || at_right) ? dx * 0.35 : dx;
        root.animating = false;
    }

    function finish_swipe(dx: length, vx: length) {
        // 位移过半屏的 24%，或甩得够快 → 切页。
        //
        // vx 是「每帧位移」。原来写成
        //     fling_boost = (vx/1px) * (page_area.width/1px) * 0.15px
        // 即"一帧走 1px 折算成 0.15 屏"—— 正常甩手 vx 就有 20~40px/帧，
        // 折算出来是 3~6 屏，阈值形同虚设，轻轻一甩就切。
        //
        // 现在按"一帧位移"直接折算，12px/帧 ≈ 一屏的 3%，
        // 与 Android 的 ViewPager fling 阈值同量级：
        //     vx = 12px  → 折算 12 * 14 = 168px，1080 宽屏约 15.5%
        // 配合 24% 的位移阈值，手感和官方接近：慢拖靠位移，快甩靠速度。
        let threshold = page_area.width * 0.18;
        let fling_boost = (vx / 1px) * 14px;
        let effective = dx + fling_boost;

        if (effective < -threshold && root.tab_index < root.page_count - 1) {
            root.go_tab_animated(root.tab_index + 1);
            return;
        }
        if (effective > threshold && root.tab_index > 0) {
            root.go_tab_animated(root.tab_index - 1);
            return;
        }
        // 没到阈值 → 回弹
        root.animating = true;
        root.swipe_dx = 0px;
        anim_reset.start();
    }

    function cancel_swipe() {
        root.animating = true;
        root.swipe_dx = 0px;
        anim_reset.start();
    }

    // --------------------------------------------------------------------------
    // 主内容
    // --------------------------------------------------------------------------
    if root.app_mode == 0 : VerticalLayout {
        padding: 0px;
        spacing: 0px;

        TopBar {
            safe_top: root.safe_top;
            current_tab <=> root.current_tab;
            open_drawer => {
                root.drawer_open = true;
                root.drawer_changed();
            }
            open_search => { root.open_search(); }
            open_message => { root.open_message(); }
            unread_count: root.unread_count;
            tab_changed(t) => {
                root.go_tab_animated(
                    (t == NavTabType.Live) ? 0
                    : (t == NavTabType.Recommend) ? 1 : 2);
            }
        }
    }

    // --------------------------------------------------------------------------
    // 页面容器：三个频道页横向排列
    //
    // 刻意不挂任何手势。横向拖动由卡片冒泡上来，纵向由 Flickable 自理。
    // 容器只负责裁剪与位移。
    // --------------------------------------------------------------------------
    page_area := Rectangle {
        visible: root.app_mode == 0;
        y: root.safe_top + Spacing.searchbar_row_height + Spacing.tabbar_row_height;
        width: root.app_mode == 0 ? 100% : 0%;
        height: root.app_mode == 0 ? (root.height - self.y - root.safe_bottom) : 0px;
        background: transparent;
        clip: true;

        // 最底层兜底横向手势：先声明 = 在下面。
        // LiveView / FollowView 是空壳，自身没有手势层，
        // 没有这个兜底就切得出去切不回来。
        PageSwipeArea {
            width: parent.width;
            height: parent.height;
            swipe(dx, dy) => { root.apply_swipe(dx); }
            swipe_finished(dx, vx) => { root.finish_swipe(dx, vx); }
            swipe_cancelled => { root.cancel_swipe(); }
        }

        HorizontalLayout {
            x: root.page_base + root.swipe_dx;
            animate x {
                duration: root.animating ? Theme.animation_duration_tab : 0ms;
                easing: ease-out;
            }

            LiveView {
                width: page_area.width;
                height: page_area.height;
            }

            recommend_page := RecommendView {
                width: page_area.width;
                height: page_area.height;
                rows: root.rows;
                feed_state: root.feed_state;
                feed_error: root.feed_error;
                has_more: root.has_more;
                loading_more: root.loading_more;
                more_error: root.more_error;
                video_selected(bvid) => { root.play_video(bvid); }
                video_long_pressed(bvid) => { root.video_long_pressed(bvid); }
                load_more => { root.load_more(); }
                swipe_horizontal(dx, dy) => { root.apply_swipe(dx); }
                swipe_horizontal_finished(dx, vx) => { root.finish_swipe(dx, vx); }
                swipe_horizontal_cancel => { root.cancel_swipe(); }
            }

            FollowView {
                width: page_area.width;
                height: page_area.height;
            }
        }
    }

    // --------------------------------------------------------------------------
    // 二级页面
    // --------------------------------------------------------------------------
    if root.app_mode == 1 : VideoDetailView {
        width: 100%;
        height: 100%;
        safe_top: root.safe_top;
        safe_bottom: root.safe_bottom;
        detail: root.current_detail;
        related_list: root.related_videos;
        comments: root.video_comments;
        back_clicked => {
            root.app_mode = 0;
            root.exit_detail_view();
        }
        like_clicked => { root.toggle_like(); }
        coin_clicked => { root.toggle_coin(); }
        fav_clicked => { root.toggle_fav(); }
        related_selected(bvid) => { root.play_video(bvid); }
    }

    // --------------------------------------------------------------------------
    // 抽屉（置顶）
    // --------------------------------------------------------------------------
    NavigationDrawer {
        is_open <=> root.drawer_open;
        safe_top: root.safe_top;
        close_drawer => {
            root.drawer_open = false;
            root.drawer_changed();
        }
    }
}
