// ==============================================================================
// 手势原语 (Gesture Primitives) —— 统一窗口坐标与严格轴向锁定
// ==============================================================================

import { UiMetrics } from "theme.slint";

/// 手势锁定后的主轴方向
export enum PanAxis {
    None,
    Horizontal,
    Vertical,
}

/// 统一手势交互组件
///
/// 核心规则：
/// 1. 坐标统一换算为窗口绝对坐标 (absolute-position + mouse)，抵消所有祖先位移，
///    杜绝在滚动/横移容器中因局部坐标漂移产生的正反馈自激与抖动。
/// 2. 严格的轴向锁定机制：
///    总位移 < tap_slop 时处于防抖区，视为可能的轻触；
///    总位移 >= tap_slop 时立即比较横纵位移绝对值：
///      - abs_dx >= abs_dy * axis_ratio 锁定为 Horizontal；
///      - 否则锁定为 Vertical。
///    锁定后在单次手势生命周期内不可逆，且绝不再触发 tap 事件。
/// 3. 系统底部导航条保护：
///    若起手触摸点落在底部 UiMetrics.system_bottom_guard 区域内，
///    直接完全忽略本次手势，绝不截断系统上滑回桌面/多任务请求。
/// 4. 速度计算采用指数平滑 (0.4 / 0.6)，抬手时提供平滑的 fling 速度。
export component GestureArea inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> respect_system_gesture: true;
    in property <length> tap_slop: 8px;
    in property <float> axis_ratio: 1.1;
    in property <bool> horizontal_enabled: true;
    in property <bool> vertical_enabled: true;
    in property <bool> long_enabled: false;

    out property <bool> pressed: touch.pressed && root.is_down && !root.dragging;
    out property <bool> is_dragging: root.dragging;
    out property <PanAxis> current_axis: root.axis;

    callback tap(length, length);
    callback long_press(length, length);
    callback pan_started(PanAxis);
    callback pan_moved(length, length);
    callback pan_finished(length, length, length, length); // dx, dy, vx, vy
    callback pan_cancelled();

    property <bool> is_down: false;
    property <bool> locked: false;
    property <bool> dragging: false;
    property <bool> long_fired: false;
    property <PanAxis> axis: PanAxis.None;

    property <length> anchor_x: 0px;
    property <length> anchor_y: 0px;
    property <length> last_x: 0px;
    property <length> last_y: 0px;
    property <length> vel_x: 0px;
    property <length> vel_y: 0px;
    property <length> start_x: 0px;
    property <length> start_y: 0px;

    long_timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            if (root.is_down && !root.locked && root.long_enabled) {
                root.long_fired = true;
                root.long_press(root.start_x, root.start_y);
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                let px = self.absolute-position.x + self.mouse-x;
                let py = self.absolute-position.y + self.mouse-y;

                // 底部系统手势保护：落在保护区内的起手直接忽略，完全让给系统
                if (root.respect_system_gesture
                    && py >= (UiMetrics.window_height - UiMetrics.system_bottom_guard)) {
                    return;
                }

                root.start_x = self.mouse-x;
                root.start_y = self.mouse-y;
                root.anchor_x = px;
                root.anchor_y = py;
                root.last_x = px;
                root.last_y = py;

                root.is_down = true;
                root.locked = false;
                root.long_fired = false;
                root.dragging = false;
                root.axis = PanAxis.None;
                root.vel_x = 0px;
                root.vel_y = 0px;

                if (root.long_enabled) {
                    long_timer.start();
                }
            } else if (event.kind == PointerEventKind.move) {
                if (!root.is_down) { return; }

                let px = self.absolute-position.x + self.mouse-x;
                let py = self.absolute-position.y + self.mouse-y;
                let dx = px - root.anchor_x;
                let dy = py - root.anchor_y;

                if (!root.locked) {
                    let ax = Math.abs(dx / 1px);
                    let ay = Math.abs(dy / 1px);
                    let slop = (root.tap_slop / 1px);

                    // 尚未超出轻触防抖阈值，继续保持静止
                    if (ax < slop && ay < slop) { return; }

                    // 超出防抖阈值，判定锁定轴向
                    if (root.horizontal_enabled && !root.vertical_enabled && ax < ay) {
                        // 明显在纵向拖动，本区域不响应，放弃本次手势
                        long_timer.stop();
                        root.is_down = false;
                        root.axis = PanAxis.None;
                        return;
                    }

                    if (!root.horizontal_enabled && root.vertical_enabled && ay < ax) {
                        // 明显在横向拖动，本区域不响应，放弃本次手势
                        long_timer.stop();
                        root.is_down = false;
                        root.axis = PanAxis.None;
                        return;
                    }

                    let is_horizontal = (root.horizontal_enabled && !root.vertical_enabled)
                        ? true
                        : (!root.horizontal_enabled && root.vertical_enabled)
                            ? false
                            : (ax >= ay * root.axis_ratio);

                    // 锁定主轴，不可逆
                    root.locked = true;
                    root.dragging = true;
                    long_timer.stop();
                    root.axis = is_horizontal ? PanAxis.Horizontal : PanAxis.Vertical;
                    root.pan_started(root.axis);
                }

                // 速度跟踪（指数平滑）
                let mvx = px - root.last_x;
                let mvy = py - root.last_y;
                root.vel_x = root.vel_x * 0.4 + mvx * 0.6;
                root.vel_y = root.vel_y * 0.4 + mvy * 0.6;
                root.last_x = px;
                root.last_y = py;

                root.pan_moved(dx, dy);
            } else if (event.kind == PointerEventKind.up) {
                long_timer.stop();
                if (!root.is_down) { return; }
                root.is_down = false;

                let px = self.absolute-position.x + self.mouse-x;
                let py = self.absolute-position.y + self.mouse-y;
                let moved = Math.abs(px - root.anchor_x) >= root.tap_slop
                         || Math.abs(py - root.anchor_y) >= root.tap_slop;

                if (root.locked) {
                    root.pan_finished(px - root.anchor_x, py - root.anchor_y,
                                      root.vel_x, root.vel_y);
                } else if (!root.long_fired && !moved) {
                    root.tap(root.start_x, root.start_y);
                }

                root.locked = false;
                root.dragging = false;
                root.axis = PanAxis.None;
            } else if (event.kind == PointerEventKind.cancel) {
                long_timer.stop();
                let was_locked = root.locked;
                root.is_down = false;
                root.locked = false;
                root.dragging = false;
                root.axis = PanAxis.None;
                root.vel_x = 0px;
                root.vel_y = 0px;
                if (was_locked) {
                    root.pan_cancelled();
                }
            }
        }
    }
}
