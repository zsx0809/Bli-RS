// ==============================================================================
// BLI-RS 主题设计规范 (Material You / Monet 动态主题引擎)
//
// 度量约定：
// 1. 所有尺寸以 px 表达，在 Slint 中 1px == 1 逻辑像素 == 1dp。
// 2. 网格间距统一走 Spacing 命名空间，禁止在组件内出现魔法数字。
// ==============================================================================

/// 导航栏当前选中的 Tab 页面类型
export enum NavTabType {
    Live,       // 直播流页面
    Recommend,  // 推荐流页面 (默认首页)
    Follow      // 关注动态流页面
}

/// 单个视频卡片数据结构定义
export struct VideoItemData {
    id: string,         // 视频唯一标识 (bvid / aid)
    title: string,      // 视频标题
    author: string,     // UP主昵称
    views: string,      // 格式化播放量 (例如: "128.4万")
    duration: string,   // 视频时长 (例如: "18:24")
    cover_url: string,  // 封面图地址（原始 URL，仅调试用）
    cover: image,       // 已解码的封面位图（Rust 侧下载并解码后填入）
    danmaku: string,    // 弹幕总数 (例如: "3.2万")
}

/// 双列瀑布流每行数据包装 (一行容纳两个视频卡片)
export struct VideoRowPair {
    left: VideoItemData,
    right: VideoItemData,
    has_right: bool,
}

/// 视频详情页面核心数据
export struct VideoDetailData {
    bvid: string,
    title: string,
    desc: string,
    author: string,
    author_face: image,
    cover: image,
    is_ready: bool,
    views: string,
    danmaku: string,
    likes: string,
    coins: string,
    favorites: string,
    shares: string,
    pubdate: string,
    is_vertical: bool,
    is_liked: bool,
    is_coined: bool,
    is_favorited: bool,
    /// 播放链路失败的原因。非空时播放器区域显示错误，不再显示"加载中"。
    load_error: string,
}

/// 相关推荐单列横向卡片数据
export struct RelatedVideoData {
    bvid: string,
    title: string,
    author: string,
    views: string,
    danmaku: string,
    duration: string,
    cover: image,
    cover_url: string,
}

/// 评论区单条评论数据
export struct CommentItemData {
    user_name: string,
    user_face: image,
    content: string,
    likes: string,
    pubtime: string,

    /// 用户等级 0~6，UI 画 LV 徽章
    level: int,
    /// 大会员：昵称染成粉色
    is_vip: bool,
    /// 视频作者：昵称后挂 UP 标
    is_up: bool,
    /// IP 属地，原始形如 "IP属地：广东"。空串时不显示
    location: string,
    /// 总回复数（含楼中楼）。>0 时显示"共 N 条回复"
    reply_count: int,
    /// 楼中楼内容，展开后显示
    sub_replies: [string],
    /// 楼中楼作者名，与 sub_replies 一一对应
    sub_authors: [string],
}

/// 全局布局度量 (Layout Metrics)
export global Spacing {
    // 页面边距与网格间距 —— 二者同值，保证左右边距与列间距视觉一致
    out property <length> page_margin: 12px;
    out property <length> grid_gap: 12px;

    // 顶栏
    out property <length> searchbar_row_height: 52px;
    out property <length> tabbar_row_height: 46px;
    out property <length> searchbar_height: 36px;

    // 卡片内部
    out property <length> card_padding: 8px;
    out property <length> card_text_gap: 6px;

    // 抽屉
    out property <length> drawer_width: 300px;
    out property <length> drawer_item_height: 48px;
    out property <length> drawer_icon_size: 20px;
    out property <length> drawer_icon_gap: 16px;

    // 手势
    out property <length> edge_swipe_width: 28px;   // 左边缘呼出抽屉的死区宽度
    out property <length> tab_swipe_threshold: 56px;
}

/// 窗口级度量（由 AppWindow 在启动与尺寸变化时写入）
///
/// 存在的理由：手势原语需要知道"屏幕最底下那一条"在哪，
/// 而那条线是窗口坐标，组件自身算不出来。
/// 走 global 而不是逐层传参 —— 否则要穿过 VideoCard / RelatedVideoCard /
/// RecommendView 三层才能到 GestureArea，每加一个页面就多一串样板。
export global UiMetrics {
    /// 窗口高度（窗口坐标）
    in-out property <length> window_height: 844px;

    /// 底部系统手势条（上滑回桌面 / 多任务）占用的高度。
    ///
    /// 这块区域的触摸由系统接管。App 若在这里也判定 tap / pan，
    /// 就会与系统手势打架 —— 表现为"想切后台，却滚了一下列表或点进了视频"。
    /// GestureArea 会直接忽略落在这条带里的起手。
    in-out property <length> system_bottom_guard: 26px;
}

/// 全局动态调色板单例
///
/// 两套完整色板：亮色 / 暗色。
/// 默认值取暗色（OLED 纯黑），实际运行时由 Rust 侧按系统 uiMode 灌入对应套，
/// 若设备支持 Monet（API 31+）再用壁纸派生色覆盖 primary/secondary 槽位。
///
/// 分层语义（Material 3 的 surface 层级）：
///   background          页面最底层，视频流就铺在这上面
///   surface             卡片本体
///   surface_container   顶栏 + 抽屉 —— 两者共用同一色，视觉上是一层
///   search_bg           搜索栏凹槽内部，与 surface_container 形成内外反差
///   surface_variant     封面占位、次级容器
export global Theme {
    // 明暗标志：UI 侧据此决定状态栏图标亮度等细节
    in-out property <bool> dark: true;

    // 主色 (Primary)
    in-out property <color> primary: #ffb1c8;
    in-out property <color> on_primary: #4a1030;
    in-out property <color> primary_container: #7b2949;
    in-out property <color> on_primary_container: #ffd9e2;

    // 次色 (Secondary)
    in-out property <color> secondary: #e5bdc6;
    in-out property <color> on_secondary: #432931;
    in-out property <color> secondary_container: #5c3f47;
    in-out property <color> on_secondary_container: #ffd9e2;

    // 哔哩互动特征色
    in-out property <color> bili_pink: #fb7299;
    in-out property <color> bili_coin: #f29c38;
    in-out property <color> bili_fav: #f4c430;

    // ----------------------------------------------------------------------
    // 背景与表面层
    // ----------------------------------------------------------------------
    in-out property <color> background: #000000;             // 页面底：暗色纯黑 / 亮色纯白
    in-out property <color> surface: #0f0d12;                // 卡片本体
    in-out property <color> surface_container: #1b1722;      // 顶栏 + 抽屉（同一层）
    in-out property <color> surface_container_high: #24202d; // 抽屉内的浮起卡片
    in-out property <color> surface_variant: #2a2535;        // 封面占位、次级容器
    in-out property <color> search_bg: #262231;              // 搜索栏凹槽内部

    // ----------------------------------------------------------------------
    // 文本与图标层
    // ----------------------------------------------------------------------
    in-out property <color> on_surface: #f2ecf4;         // 主标题
    in-out property <color> on_surface_variant: #b5abc0; // UP 主、副信息
    in-out property <color> outline: #4a4356;            // 卡片描边、tab 胶囊轮廓
    in-out property <color> outline_variant: #2e2938;    // 分割线

    // 特殊状态色
    in-out property <color> scrim: #00000099;            // 抽屉遮罩

    // 形状与圆角规范
    in-out property <length> radius_sm: 8px;
    in-out property <length> radius_md: 14px;
    in-out property <length> radius_lg: 22px;
    in-out property <length> radius_full: 9999px;

    // 动画曲线（针对 120Hz 高刷新率调优）
    in-out property <duration> animation_duration_normal: 200ms;
    in-out property <duration> animation_duration_fast: 100ms;
    in-out property <duration> animation_duration_tab: 180ms;
}
