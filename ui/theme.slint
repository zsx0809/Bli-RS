// ==============================================================================
// BLI-RS 主题设计规范 (Material You / Monet 动态主题引擎)
// ==============================================================================

/// 导航栏当前选中的 Tab 页面类型
export enum NavTabType {
    Live,       // 直播流页面
    Recommend,  // 推荐流页面 (默认首页)
    Follow      // 关注动态流页面
}

/// 单个视频卡片数据结构定义
export struct VideoItemData {
    id: string,         // 视频唯一标识 (bvid / aid)
    title: string,      // 视频标题
    author: string,     // UP主昵称
    views: string,      // 格式化播放量 (例如: "128.4万")
    duration: string,   // 视频时长 (例如: "18:24")
    cover_url: string,  // 封面图地址
    danmaku: string,    // 弹幕总数 (例如: "3.2万")
}

/// 双列瀑布流每行数据包装 (一行容纳两个视频卡片)
export struct VideoRowPair {
    left: VideoItemData,
    right: VideoItemData,
    has_right: bool,
}

/// 全局动态调色板单例
export global Theme {
    // 主色 (Primary)
    in-out property <color> primary: #ffb1c8;
    in-out property <color> on_primary: #5e1133;
    in-out property <color> primary_container: #7b2949;
    in-out property <color> on_primary_container: #ffd9e2;

    // 次色 (Secondary)
    in-out property <color> secondary: #e5bdc6;
    in-out property <color> on_secondary: #432931;
    in-out property <color> secondary_container: #5c3f47;
    in-out property <color> on_secondary_container: #ffd9e2;

    // 背景与表面层 (Surface & Background)
    in-out property <color> background: #121011;           // 更加深邃纯净的 OLED 黑灰
    in-out property <color> surface: #1c1819;              // 双列卡片底色
    in-out property <color> surface_variant: #2d2628;      // 封面占位与副容器色
    in-out property <color> surface_container_high: #262022; // 抽屉侧边栏浮动色

    // 文本与图标层
    in-out property <color> on_surface: #ece0e2;          // 主标题纯白色
    in-out property <color> on_surface_variant: #bfaeb2;  // UP主等副信息灰白色
    in-out property <color> outline: #8c7b7f;             // 弱化边框

    // 特殊状态色
    in-out property <color> scrim: #00000099;             // 抽屉遮罩半透明色

    // 形状与圆角规范
    in-out property <length> radius_sm: 8px;   // 小圆角 (时长角标)
    in-out property <length> radius_md: 14px;  // 中圆角 (双列视频卡片 M3 规范圆角)
    in-out property <length> radius_lg: 22px;  // 大圆角 (抽屉面板)
    in-out property <length> radius_full: 9999px;

    // 动画曲线
    in-out property <duration> animation_duration_normal: 260ms;
    in-out property <duration> animation_duration_fast: 140ms;
}
