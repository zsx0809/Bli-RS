// ==============================================================================
// BLI-RS 主题设计规范 (Material You / Monet 动态主题引擎)
// 
// 本文件定义了符合 Google Material Design 3 (M3) 标准的设计变量。
// 包含色彩系统、间距规范、圆角大小、排版字阶以及物理动效曲线。
// 后续如有更强的前端模型介入，可以直接在此调优色相和动画参数。
// ==============================================================================

/// 导航栏当前选中的 Tab 页面类型
export enum NavTabType {
    Live,       // 直播流页面
    Recommend,  // 推荐流页面 (默认首页)
    Follow      // 关注动态流页面
}

/// 视频卡片数据结构定义
export struct VideoItemData {
    id: string,         // 视频唯一标识 (bvid / aid)
    title: string,      // 视频标题
    author: string,     // UP主昵称
    views: string,      // 格式化播放量 (例如: "128.4万")
    duration: string,   // 视频时长 (例如: "18:24")
    cover_url: string,  // 封面图地址
    danmaku: string,    // 弹幕总数 (例如: "3.2万")
}

/// 全局动态调色板单例 (后期可通过 Rust NDK 实时注入系统的 Monet 壁纸取色)
export global Theme {
    // --------------------------------------------------------------------------
    // 1. 色彩系统 (M3 Color Tokens) - 默认高对比度暗色系 (Dark Palette)
    // --------------------------------------------------------------------------
    
    // 主色 (Primary) - 用于激活状态、主按钮、进度条高亮 (默认采用融合B站粉与M3洋红的高辨识度色彩)
    in-out property <color> primary: #ffb1c8;
    in-out property <color> on_primary: #5e1133;
    in-out property <color> primary_container: #7b2949;
    in-out property <color> on_primary_container: #ffd9e2;

    // 次色 (Secondary) - 用于次级胶囊背景、非关键指示器
    in-out property <color> secondary: #e5bdc6;
    in-out property <color> on_secondary: #432931;
    in-out property <color> secondary_container: #5c3f47;
    in-out property <color> on_secondary_container: #ffd9e2;

    // 背景与表面层 (Surface & Background) - 多层级高度沉浸黑灰阶
    in-out property <color> background: #1a1114;           // 最底层全局背景
    in-out property <color> surface: #201a1c;              // 基础表面层 (卡片、顶栏底色)
    in-out property <color> surface_variant: #352d30;      // 高亮表面层 (搜索框、悬浮输入框)
    in-out property <color> surface_container_high: #2b2427; // 抽屉侧边栏等浮动容器底色

    // 文本与图标层 (On Surface Tokens)
    in-out property <color> on_surface: #ece0e2;          // 主标题纯白/高光色
    in-out property <color> on_surface_variant: #d6c2c6;  // 副标题中灰度色
    in-out property <color> outline: #9f8c90;             // 弱化边框描边色

    // 特殊状态色
    in-out property <color> scrim: #00000088;             // 遮罩蒙层阴影色 (抽屉弹出时的黑色半透明底)

    // --------------------------------------------------------------------------
    // 2. 形状与圆角规范 (M3 Shape Tokens)
    // --------------------------------------------------------------------------
    in-out property <length> radius_sm: 8px;   // 小圆角 (标签、视频时长角标)
    in-out property <length> radius_md: 12px;  // 中圆角 (按钮、输入框)
    in-out property <length> radius_lg: 20px;  // 大圆角 (视频卡片外壳)
    in-out property <length> radius_full: 9999px; // 全圆角 (头像、Tab 选中胶囊指示条)

    // --------------------------------------------------------------------------
    // 3. 物理动力学规范 (Material Motion Tokens)
    // --------------------------------------------------------------------------
    // 标准减速曲线时长 (用于页面切入、抽屉滑出)
    in-out property <duration> animation_duration_normal: 300ms;
    in-out property <duration> animation_duration_fast: 150ms;
    
    // 触控交互开关
    in-out property <bool> is_touch_device: true;
}
