// ==============================================================================
// 矢量图标集 (Vector Icons)
//
// 为什么不用 emoji：
// 1. emoji 由系统字体渲染，风格/饱和度/描边由厂商决定，跨设备不可控。
// 2. 无法统一着色，无法参与主题切换。
// 3. 本组件全部基于 24x24 viewbox 的 Path，统一 1.6px 描边、currentColor 语义。
// ==============================================================================

import { Theme } from "../theme.slint";

/// 图标基类：统一 24x24 viewbox、统一描边、统一颜色来源
export component IconBase inherits Rectangle {
    in property <string> commands;
    in property <color> tint: Theme.on_surface_variant;
    in property <length> stroke_w: 1.6px;
    in property <bool> fill_mode: false;
    in property <length> size: 24px;

    width: self.size;
    height: self.size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        stroke: root.fill_mode ? transparent : root.tint;
        stroke-width: root.stroke_w;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.fill_mode ? root.tint : transparent;
    }
}

/// 放大镜 (搜索)
export component IconSearch inherits IconBase {
    commands: "M 10.5 4 A 6.5 6.5 0 1 1 10.5 17 A 6.5 6.5 0 1 1 10.5 4 Z M 15.2 15.2 L 20 20";
}

