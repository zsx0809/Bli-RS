// ==============================================================================
// 顶部应用栏 (TopBar) —— 对齐 B 站官方客户端的两行结构
//
// 布局结构：
//   第一行：[头像]        [—— 搜索栏 ——]        [消息🔔]
//   第二行：              [ 直播|推荐|关注 ]
//
// 布局原则（对齐靠柱）：
// 1. 搜索栏与 Tab 胶囊**同宽（216px）且都水平居中**，左右边缘形成一条
//    垂直对齐的"柱"，两行视觉上是一个整体，而不是各自浮动。
// 2. 头像贴左边缘、消息贴右边缘，二者同为 34px，围绕中间那条柱对称。
// 3. 中间的柱是固定宽度而非撑满 —— 只有固定宽度才能与 Tab 精确对齐；
//    撑满会吃掉头像与铃铛之间的空间，破坏对齐关系。
// ==============================================================================

import { Theme, NavTabType, Spacing } from "../theme.slint";
import { IconSearch, IconBell } from "icons.slint";


// 单个 Tab 按钮：内层圆角 = 外层 9999px - padding 3px，保持同心
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    border-radius: Theme.radius_full;
    background: root.active ? Theme.primary : transparent;
    animate background { duration: Theme.animation_duration_tab; }

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.active ? Theme.on_primary : (Theme.dark ? Theme.on_surface_variant : Theme.on_surface);
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.animation_duration_tab; }
    }
}

export component TopBar inherits Rectangle {
    in-out property <NavTabType> current_tab: NavTabType.Recommend;
    in property <length> safe_top: 0px;
    in property <int> unread_count: 0;

    callback open_drawer();
    callback tab_changed(NavTabType);
    callback open_search();
    callback open_message();

    height: root.safe_top + Spacing.searchbar_row_height + Spacing.tabbar_row_height;
    // 顶栏用 surface_container —— 与抽屉同一层色，两者视觉上是一整块
    background: Theme.surface_container;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 状态栏安全区
        Rectangle {
            height: root.safe_top;
            background: transparent;
        }

        // ----------------------------------------------------------------------
        // 第一行：头像(贴左) + 搜索栏(居中，与 Tab 同宽) + 消息(贴右)
        //
        // 用绝对定位而非 HorizontalLayout：搜索栏必须与 Tab 胶囊严格同宽同轴，
        // 布局的伸缩分配做不到"固定宽度 + 精确居中"。
        // ----------------------------------------------------------------------
        Rectangle {
            height: Spacing.searchbar_row_height;
            background: transparent;

            // 中间柱宽度：与第二行 Tab 胶囊一致
            property <length> column_w: 216px;

            // 头像 —— 贴左边缘
            TouchArea {
                x: Spacing.page_margin;
                y: (parent.height - 34px) * 0.5;
                width: 34px;
                height: 34px;
                clicked => { root.open_drawer(); }

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: Theme.radius_full;
                    background: Theme.primary;

                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 4 12 C 7 7.5 13 7.5 16 11 L 20.5 8.2 L 19.6 15.8 L 16 13 C 13 16.5 7 16.5 4 12 Z";
                        fill: Theme.on_primary;
                        stroke: transparent;
                    }
                }
            }

            // 搜索栏 —— 与 Tab 胶囊同宽同轴
            TouchArea {
                x: (parent.width - parent.column_w) * 0.5;
                y: (parent.height - Spacing.searchbar_height) * 0.5;
                width: parent.column_w;
                height: Spacing.searchbar_height;
                clicked => { root.open_search(); }

                Rectangle {
                    height: parent.height;
                    border-radius: Theme.radius_full;
                    // 搜索栏内部：亮色下纯白、暗色下比顶栏亮一档 —— 形成"凹槽"
                    background: Theme.search_bg;
                    border-width: 1px;
                    border-color: Theme.outline_variant;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: start;

                        IconSearch {
                            size: 17px;
                            tint: Theme.on_surface_variant;
                        }

                        Text {
                            text: "搜索视频、UP 主";
                            color: Theme.outline;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // 消息入口 —— 贴右边缘，与头像围绕中间柱对称
            TouchArea {
                x: parent.width - Spacing.page_margin - 34px;
                y: (parent.height - 34px) * 0.5;
                width: 34px;
                height: 34px;
                clicked => { root.open_message(); }

                IconBell {
                    x: 5px;
                    y: 5px;
                    size: 24px;
                    tint: Theme.on_surface_variant;
                }

                // 未读红点
                if root.unread_count > 0 : Rectangle {
                    x: 24px;
                    y: 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: Theme.radius_full;
                    background: #ff4d6a;
                    border-width: 1.5px;
                    border-color: Theme.background;
                }
            }
        }

        // ----------------------------------------------------------------------
        // 第二行：胶囊 Tab 切换器
        // ----------------------------------------------------------------------
        Rectangle {
            height: Spacing.tabbar_row_height;
            background: transparent;

            HorizontalLayout {
                alignment: center;

                // 216px —— 与第一行搜索栏同宽，两者左右边缘严格对齐。
                // 底色与顶栏同为 surface_container，靠 1px 轮廓线划出界限，
                // 而不是靠填色差异 —— 这样顶栏整体是一块，胶囊是嵌进去的控件。
                Rectangle {
                    width: 216px;
                    height: 38px;
                    border-radius: Theme.radius_full;
                    background: Theme.surface_container;
                    border-width: 1px;
                    border-color: Theme.outline;

                    HorizontalLayout {
                        spacing: 2px;
                        padding: 3px;

                        TabButton {
                            text: "直播";
                            active: root.current_tab == NavTabType.Live;
                            clicked => {
                                root.current_tab = NavTabType.Live;
                                root.tab_changed(NavTabType.Live);
                            }
                        }
                        TabButton {
                            text: "推荐";
                            active: root.current_tab == NavTabType.Recommend;
                            clicked => {
                                root.current_tab = NavTabType.Recommend;
                                root.tab_changed(NavTabType.Recommend);
                            }
                        }
                        TabButton {
                            text: "关注";
                            active: root.current_tab == NavTabType.Follow;
                            clicked => {
                                root.current_tab = NavTabType.Follow;
                                root.tab_changed(NavTabType.Follow);
                            }
                        }
                    }
                }
            }
        }

        // 顶栏底部分割线：把它与视频区分开
        Rectangle {
            height: 1px;
            background: Theme.outline_variant;
        }
    }
}
