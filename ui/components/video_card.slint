// ==============================================================================
// 双列竖版视频卡片组件 (Vertical Grid Video Card)
//
// 设计定位：
// 1. 上下结构：上方为视频封面（含播放量/弹幕/时长徽章），下方为标题与UP主。
// 2. 适用于双列瀑布流推荐页，最大化利用移动端横向空间。
// ==============================================================================

import { Theme, VideoItemData } from "../theme.slint";

export component VideoCard inherits Rectangle {
    in property <VideoItemData> data;
    callback clicked();

    background: Theme.surface;
    border-radius: Theme.radius_md;
    clip: true;

    // 触控交互水波纹
    TouchArea {
        clicked => { root.clicked(); }

        Rectangle {
            width: 100%;
            height: 100%;
            background: parent.pressed ? Theme.primary.transparentize(85%) : Colors.transparent;
            animate background { duration: Theme.animation_duration_fast; }
        }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 6px;

        // ----------------------------------------------------------------------
        // 1. 顶部视频封面区域 (16:10 沉浸比例)
        // ----------------------------------------------------------------------
        Rectangle {
            height: 106px;
            background: Theme.surface_variant;
            border-top-left-radius: Theme.radius_md;
            border-top-right-radius: Theme.radius_md;
            clip: true;

            // 封面占位标示
            Text {
                text: "BILIBILI";
                color: Theme.outline;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // 封面底部渐变投影蒙层 (确保白色角标清晰可见)
            Rectangle {
                y: parent.height - 24px;
                height: 24px;
                background: #00000077;
            }

            // 封面左下角：播放量与弹幕数
            HorizontalLayout {
                x: 6px;
                y: parent.height - 18px;
                spacing: 6px;

                Text {
                    text: "▶ " + root.data.views;
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 500;
                }

                Text {
                    text: "💬 " + root.data.danmaku;
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 500;
                }
            }

            // 封面右下角：时长
            Rectangle {
                x: parent.width - self.width - 5px;
                y: parent.height - self.height - 3px;
                width: 38px;
                height: 16px;
                background: #00000099;
                border-radius: 4px;

                Text {
                    text: root.data.duration;
                    color: #ffffff;
                    font-size: 9px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ----------------------------------------------------------------------
        // 2. 底部视频文字信息区域
        // ----------------------------------------------------------------------
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            spacing: 4px;
            alignment: space-between;

            // 两行截断标题
            Text {
                text: root.data.title;
                color: Theme.on_surface;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
                max-height: 38px;
                overflow: elide;
            }

            // UP 主信息
            HorizontalLayout {
                spacing: 4px;

                Text {
                    text: "UP";
                    color: Theme.primary;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.data.author;
                    color: Theme.on_surface_variant;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
