// ==============================================================================
// 视频详情与二级播放页面 (Video Detail & Player View)
//
// ==============================================================================
// 交互
// ==============================================================================
//
// 1. 点击一律用 GestureArea，不用 TouchArea。
//    TouchArea.clicked 不判位移，右滑会被翻译成点击（见 ui/gesture.slint）。
//
// 2. 左边缘返回归 App，不归系统。
//    Rust 侧全程保持 setSystemGestureExclusionRects，边缘区归 EdgeBack。
//
// 3. 滚动自管，不叠 Flickable。
//    content_layer.y = -scroll_y，跟手即时。
//
// 4. 横向滑动切换「简介 / 评论」。
//    内容层跟着手指走（tab_dx），松手按位移或甩速决定切换还是回弹。
//    这是详情页唯一的横向语义 —— 详情页不存在"切视频"的横滑。
//
// 5. Tab 栏固定在播放器下方，不随内容滚动。
//    早期把它塞进 content_layer，结果一滚动就看不见，想切 Tab 得先滚回顶部。
//
// 6. 底部系统手势条让给系统。
//    GestureArea 的 respect_system_gesture（默认开）会忽略落在底部
//    UiMetrics.system_bottom_guard 高度内的起手，避免"想切后台却滚了列表"。
//
// ==============================================================================
// 坐标（见 ui/gesture.slint 的完整推演）
// ==============================================================================
//
// GestureArea 发出的 dx / dy 已经是**窗口绝对坐标**下的位移，
// 所以内容和手指 1:1 跟随时不会产生正反馈。
// 这里绝不要拿 mouse-x / mouse-y 自己算位移。
// ==============================================================================

import { Theme, Spacing, VideoDetailData, RelatedVideoData, CommentItemData } from "../theme.slint";
import {
    IconBack, IconLike, IconDislike, IconCoin, IconStar, IconShare,
    IconChevronDown, IconChevronUp, IconPlay, IconDanmaku
} from "../components/icons.slint";
import { RelatedVideoCard } from "../components/related_card.slint";
import { GestureArea, PanAxis } from "../gesture.slint";

export component VideoDetailView inherits Rectangle {
    in property <VideoDetailData> detail;
    in property <[RelatedVideoData]> related_list;
    in property <[CommentItemData]> comments: [];
    in property <length> safe_top: 0px;
    in property <length> safe_bottom: 0px;

    in-out property <bool> desc_expanded: false;
    in-out property <int> active_tab: 0;
    in-out property <bool> is_following: false;

    callback back_clicked();
    callback like_clicked();
    callback dislike_clicked();
    callback coin_clicked();
    callback fav_clicked();
    callback share_clicked();
    callback follow_clicked();
    callback related_selected(string);

    background: Theme.background;

    // 播放器动态高度：竖屏 45% 视口（自适应高度，绝不过度压盖 UI），横屏 16:9
    out property <length> player_height: root.detail.is_vertical
        ? Math.min(Math.max(220px, (root.height - root.safe_top) * 0.45), 380px)
        : (root.width * 9 / 16);

    property <length> tabbar_h: 46px;

    // ----------------------------------------------------------------------
    // 滚动状态
    // ----------------------------------------------------------------------
    property <length> scroll_y: 0px;
    property <length> drag_base: 0px;
    property <length> fling_vel: 0px;

    // ----------------------------------------------------------------------
    // 横向切 Tab 状态
    // ----------------------------------------------------------------------
    property <length> tab_dx: 0px;
    property <bool> tab_animating: false;
    property <PanAxis> active_axis: PanAxis.None;

    out property <length> content_h: body.preferred-height;
    out property <length> viewport_h: root.height - root.safe_top - root.player_height - root.tabbar_h - root.safe_bottom;
    out property <length> max_scroll: Math.max(0px, root.content_h - root.viewport_h);

    fling_timer := Timer {
        interval: 10ms;
        running: false;
        triggered => {
            if (Math.abs(root.fling_vel) < 0.5px) {
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            let next = root.scroll_y + root.fling_vel;
            if (next <= 0px) {
                root.scroll_y = 0px;
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            if (next >= root.max_scroll) {
                root.scroll_y = root.max_scroll;
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            root.scroll_y = next;
            root.fling_vel = root.fling_vel * 0.95;
        }
    }

    // ----------------------------------------------------------------------
    // 统一的 pan 状态机
    //
    // 所有 GestureArea（底层滚动层、相关视频卡片）都回调到这里，
    // 保证同一时刻只有一套状态在写 scroll_y / tab_dx。
    // ----------------------------------------------------------------------
    function pan_begin(axis: PanAxis) {
        root.active_axis = axis;
        fling_timer.stop();
        root.fling_vel = 0px;
        root.tab_animating = false;

        if (axis == PanAxis.Vertical) {
            root.drag_base = root.scroll_y;
        }
    }

    function pan_move(dx: length, dy: length) {
        if (root.active_axis == PanAxis.Vertical) {
            root.scroll_y = Math.max(0px, Math.min(root.max_scroll, root.drag_base - dy));
        } else if (root.active_axis == PanAxis.Horizontal) {
            // 到头了还继续往外拖 → 30% 阻尼（"墙"）
            let at_left = (root.active_tab == 0 && dx > 0px);
            let at_right = (root.active_tab == 1 && dx < 0px);
            root.tab_dx = (at_left || at_right) ? dx * 0.3 : dx;
        }
    }

    function pan_end(dx: length, dy: length, vx: length, vy: length) {
        if (root.active_axis == PanAxis.Vertical) {
            let v = -vy;
            if ((v / 1px) > 2.5) {
                root.fling_vel = Math.min(v, 60px);
                fling_timer.start();
            } else if ((v / 1px) < -2.5) {
                root.fling_vel = Math.max(v, -60px);
                fling_timer.start();
            }
        } else if (root.active_axis == PanAxis.Horizontal) {
            // 位移过半屏的 22%，或甩得够快，就切。
            // vx 是 px / move 事件，折算成"一帧位移 ≈ 12px 就够快"。
            let threshold = root.width * 0.22;
            let boost = (vx / 1px) * 12px;
            let effective = root.tab_dx + boost;

            let go_comment = (effective < -threshold && root.active_tab == 0);
            let go_intro = (effective > threshold && root.active_tab == 1);

            if (go_comment || go_intro) {
                root.active_tab = go_comment ? 1 : 0;
                root.scroll_y = 0px;
                root.tab_dx = 0px;
                root.fling_vel = 0px;
            } else {
                // 回弹
                root.tab_animating = true;
                root.tab_dx = 0px;
            }
        }
        root.active_axis = PanAxis.None;
    }

    function pan_cancel() {
        root.fling_vel = 0px;
        root.tab_animating = true;
        root.tab_dx = 0px;
        root.active_axis = PanAxis.None;
    }

    // ----------------------------------------------------------------------
    // 左右双向边缘侧滑返回状态
    // ----------------------------------------------------------------------
    property <length> left_edge_dx: 0px;
    property <bool> left_edge_active: false;
    property <length> right_edge_dx: 0px;
    property <bool> right_edge_active: false;

    // 顶部状态栏安全占位，留出手机顶部状态栏空间
    status_bar_spacer := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.safe_top;
        background: #000000;
    }

    // ----------------------------------------------------------------------
    // 顶部播放视口
    // ----------------------------------------------------------------------
    player_box := Rectangle {
        x: 0px;
        y: root.safe_top;
        width: root.width;
        height: root.player_height;
        background: #000000;
        clip: true;

        Image {
            source: root.detail.cover;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.detail.is_ready ? 0 : 1;
            animate opacity { duration: 240ms; }
        }

        // 加载中 / 失败。
        //
        // 失败必须显式画出来：原来的实现里，日志打一句 "取 playurl 失败" 就
        // return 了，UI 永远停在"视频加载中…"。
        // 用户看到的是一个不动也不报错的播放器，唯一出路是返回，
        // 于是表现为"点了一下、什么都没发生、然后自己跳了下一个视频"。
        if !root.detail.is_ready && root.detail.load_error == "" : Rectangle {
            width: 116px;
            height: 32px;
            background: #00000088;
            border-radius: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Text {
                text: "视频加载中…";
                color: #ffffff;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.detail.load_error != "" : Rectangle {
            width: parent.width - 48px;
            background: transparent;
            x: 24px;
            y: (parent.height - self.height) / 2;
            height: err_col.preferred-height;

            err_col := VerticalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: "无法播放";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.detail.load_error;
                    color: #ffffffaa;
                    font-size: 11px;
                    wrap: word-wrap;
                    max-lines: 3;
                    overflow: elide;
                    horizontal-alignment: center;
                }
            }
        }

        // 返回键：48px 命中区，视觉 32px 圆，位于播放视口左上角
        back_btn := GestureArea {
            x: 6px;
            y: 6px;
            width: 48px;
            height: 48px;

            tap(x, y) => { root.back_clicked(); }

            Rectangle {
                x: 8px;
                y: 8px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: back_btn.pressed ? #000000AA : #00000066;
                animate background { duration: Theme.animation_duration_fast; }

                IconBack {
                    x: 4px;
                    y: 4px;
                    size: 24px;
                    tint: #ffffff;
                }
            }
        }
    }

    // ----------------------------------------------------------------------
    // Sub-Tab 栏（固定，不随内容滚动）
    // ----------------------------------------------------------------------
    Rectangle {
        x: 0px;
        y: root.safe_top + root.player_height;
        width: 100%;
        height: root.tabbar_h;
        background: Theme.background;

        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.outline_variant.transparentize(60%);
        }

        HorizontalLayout {
            padding-left: Spacing.page_margin;
            padding-right: Spacing.page_margin;
            alignment: space-between;

            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                intro_tab := GestureArea {
                    width: 60px;
                    height: root.tabbar_h;
                    tap(x, y) => {
                        root.active_tab = 0;
                        root.scroll_y = 0px;
                        root.tab_dx = 0px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;

                        Text {
                            text: "简介";
                            font-size: 14px;
                            font-weight: root.active_tab == 0 ? 700 : 500;
                            color: root.active_tab == 0 ? Theme.primary : Theme.on_surface_variant;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 2px;
                            background: root.active_tab == 0 ? Theme.primary : transparent;
                            border-radius: 1px;
                            animate background { duration: Theme.animation_duration_fast; }
                        }
                    }
                }

                comment_tab := GestureArea {
                    width: 84px;
                    height: root.tabbar_h;
                    tap(x, y) => {
                        root.active_tab = 1;
                        root.scroll_y = 0px;
                        root.tab_dx = 0px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;

                        Text {
                            text: root.comments.length > 0
                                ? "评论 " + root.comments.length
                                : "评论";
                            font-size: 14px;
                            font-weight: root.active_tab == 1 ? 700 : 500;
                            color: root.active_tab == 1 ? Theme.primary : Theme.on_surface_variant;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 2px;
                            background: root.active_tab == 1 ? Theme.primary : transparent;
                            border-radius: 1px;
                            animate background { duration: Theme.animation_duration_fast; }
                        }
                    }
                }
            }

            Rectangle {
                width: 110px;
                height: 28px;
                border-radius: 14px;
                background: Theme.surface_variant;
                y: 9px;

                Text {
                    text: "点我发弹幕";
                    color: Theme.on_surface_variant;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ----------------------------------------------------------------------
    // 内容区（自适应剩余视口高度）
    // ----------------------------------------------------------------------
    scroll_clip := Rectangle {
        x: 0px;
        y: root.safe_top + root.player_height + root.tabbar_h;
        width: root.width;
        height: Math.max(0px, root.viewport_h);
        clip: true;
        background: Theme.background;

        // 底层手势：纵向滚动 + 横向切 Tab (简介 <-> 评论)
        scroll_gesture := GestureArea {
            width: 100%;
            height: 100%;
            tap_slop: 8px;
            axis_ratio: 1.1;

            pan_started(axis) => { root.pan_begin(axis); }
            pan_moved(dx, dy) => { root.pan_move(dx, dy); }
            pan_finished(dx, dy, vx, vy) => { root.pan_end(dx, dy, vx, vy); }
            pan_cancelled => { root.pan_cancel(); }
        }

        content_layer := Rectangle {
            width: parent.width;
            height: Math.max(parent.height, root.content_h);
            y: -root.scroll_y;
            x: root.tab_dx;

            animate x {
                duration: root.tab_animating ? Theme.animation_duration_normal : 0ms;
                easing: ease-out;
            }

            body := VerticalLayout {
                width: parent.width;
                padding: 0px;
                spacing: 0px;
                alignment: start;

                // ================= 简介 Tab =================
                if root.active_tab == 0 : VerticalLayout {
                    spacing: 0px;

                    // ---- UP 主 ----
                    Rectangle {
                        height: 60px;
                        width: 100%;

                        HorizontalLayout {
                            padding-left: Spacing.page_margin;
                            padding-right: Spacing.page_margin;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: Theme.surface_variant;
                                    clip: true;
                                    y: 10px;

                                    Image {
                                        source: root.detail.author_face;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }

                                    if root.detail.author_face.width == 0 : Text {
                                        text: "UP";
                                        color: Theme.outline;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: root.detail.author;
                                        color: Theme.on_surface;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: "UP主 · 优质创作者";
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                    }
                                }
                            }

                            follow_btn := GestureArea {
                                width: root.is_following ? 64px : 72px;
                                height: 30px;
                                y: 15px;

                                tap(x, y) => {
                                    root.is_following = !root.is_following;
                                    root.follow_clicked();
                                }

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 15px;
                                    background: root.is_following ? Theme.surface_variant : Theme.bili_pink;

                                    Text {
                                        text: root.is_following ? "已关注" : "+ 关注";
                                        color: root.is_following ? Theme.on_surface_variant : #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ---- 标题与简介 ----
                    VerticalLayout {
                        padding-left: Spacing.page_margin;
                        padding-right: Spacing.page_margin;
                        padding-top: 4px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        title_hit := GestureArea {
                            width: 100%;
                            height: title_row.preferred-height;

                            tap(x, y) => { root.desc_expanded = !root.desc_expanded; }

                            title_row := HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: root.detail.title;
                                    color: Theme.on_surface;
                                    font-size: 15px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    max-lines: root.desc_expanded ? 10 : 2;
                                    overflow: elide;
                                    width: root.width - 56px;
                                }

                                VerticalLayout {
                                    alignment: start;
                                    y: 2px;

                                    if !root.desc_expanded : IconChevronDown {
                                        size: 20px;
                                        tint: Theme.on_surface_variant;
                                    }
                                    if root.desc_expanded : IconChevronUp {
                                        size: 20px;
                                        tint: Theme.on_surface_variant;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 3px;
                                IconPlay { size: 10px; tint: Theme.on_surface_variant; y: 2px; }
                                Text { text: root.detail.views; color: Theme.on_surface_variant; font-size: 11px; }
                            }

                            HorizontalLayout {
                                spacing: 3px;
                                IconDanmaku { size: 10px; tint: Theme.on_surface_variant; y: 2px; }
                                Text { text: root.detail.danmaku; color: Theme.on_surface_variant; font-size: 11px; }
                            }

                            Text {
                                text: root.detail.pubdate;
                                color: Theme.on_surface_variant;
                                font-size: 11px;
                            }
                        }

                        if root.desc_expanded : Text {
                            text: root.detail.desc != "" ? root.detail.desc : "暂无简介";
                            color: Theme.on_surface_variant;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // ---- 五联条 ----
                    Rectangle {
                        height: 62px;
                        width: 100%;

                        HorizontalLayout {
                            padding-left: Spacing.page_margin;
                            padding-right: Spacing.page_margin;
                            alignment: space-around;

                            like_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.like_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconLike {
                                        size: 22px;
                                        tint: root.detail.is_liked ? Theme.bili_pink : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_liked;
                                    }
                                    Text {
                                        text: root.detail.likes;
                                        color: root.detail.is_liked ? Theme.bili_pink : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            dislike_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.dislike_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconDislike { size: 22px; tint: Theme.on_surface_variant; }
                                    Text {
                                        text: "不喜欢";
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            coin_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.coin_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconCoin {
                                        size: 22px;
                                        tint: root.detail.is_coined ? Theme.bili_coin : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_coined;
                                    }
                                    Text {
                                        text: root.detail.coins;
                                        color: root.detail.is_coined ? Theme.bili_coin : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            fav_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.fav_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconStar {
                                        size: 22px;
                                        tint: root.detail.is_favorited ? Theme.bili_fav : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_favorited;
                                    }
                                    Text {
                                        text: root.detail.favorites;
                                        color: root.detail.is_favorited ? Theme.bili_fav : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            share_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.share_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconShare { size: 22px; tint: Theme.on_surface_variant; }
                                    Text {
                                        text: root.detail.shares;
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 1px;
                        background: Theme.outline_variant.transparentize(70%);
                    }

                    // ---- 相关推荐 ----
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 40px;
                        spacing: 4px;

                        // 卡片自带 GestureArea：纵向滚、横向切 Tab 都冒泡上来，
                        // 保证压在卡片上的手势和压在空隙上的行为完全一致。
                        for item in root.related_list : RelatedVideoCard {
                            data: item;
                            clicked => { root.related_selected(item.bvid); }
                            pan_started(axis) => { root.pan_begin(axis); }
                            pan_moved(dx, dy) => { root.pan_move(dx, dy); }
                            pan_finished(dx, dy, vx, vy) => { root.pan_end(dx, dy, vx, vy); }
                            pan_cancelled => { root.pan_cancel(); }
                        }
                    }
                }

                // ================= 评论 Tab =================
                //
                // 排版目标（对着 PiliPlus / 官方客户端）：
                //   正文 15px、昵称 13px、元信息 11px、条目间距 22px + 分割线。
                // 之前是 13 / 12 / 10 + 16px 间距，字小且挤，读起来费劲。
                if root.active_tab == 1 : VerticalLayout {
                    padding-left: Spacing.page_margin + 2px;
                    padding-right: Spacing.page_margin + 2px;
                    padding-top: 14px;
                    padding-bottom: 48px;
                    spacing: 0px;

                    if root.comments.length == 0 : Rectangle {
                        height: 140px;

                        Text {
                            text: "评论加载中…";
                            color: Theme.on_surface_variant;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for comment in root.comments : VerticalLayout {
                        spacing: 0px;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            padding-bottom: 18px;
                            padding-top: 2px;

                            // 头像
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.surface_variant;
                                clip: true;

                                Image {
                                    source: comment.user_face;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                spacing: 7px;

                                Text {
                                    text: comment.user_name;
                                    color: Theme.on_surface_variant;
                                    font-size: 13px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: comment.content;
                                    color: Theme.on_surface;
                                    font-size: 15px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 18px;
                                    alignment: start;

                                    Text {
                                        text: comment.pubtime;
                                        color: Theme.outline;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: "赞 " + comment.likes;
                                        color: Theme.outline;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }

                        // 分割线：条目之间靠它划界，比纯留白清楚
                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: Theme.outline_variant.transparentize(75%);
                        }
                        Rectangle {
                            width: 100%;
                            height: 18px;
                            background: transparent;
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------------
    // 左右双边缘侧滑返回（左边右滑、右边左滑均返回首页）
    // ----------------------------------------------------------------------
    left_edge_back := GestureArea {
        x: 0px;
        y: root.safe_top + 48px;
        width: 44px;
        height: Math.max(0px, root.height - root.safe_top - 48px);

        tap_slop: 8px;
        axis_ratio: 0.9;
        vertical_enabled: false;

        tap(x, y) => { }

        pan_started(axis) => {
            root.left_edge_active = true;
            root.left_edge_dx = 0px;
        }
        pan_moved(dx, dy) => {
            if (dx > 0px) { root.left_edge_dx = dx; }
        }
        pan_finished(dx, dy, vx, vy) => {
            root.left_edge_active = false;
            root.left_edge_dx = 0px;
            if (dx > 25px || (vx / 1px) > 1.5) {
                root.back_clicked();
            }
        }
        pan_cancelled => {
            root.left_edge_active = false;
            root.left_edge_dx = 0px;
        }
    }

    right_edge_back := GestureArea {
        x: root.width - 44px;
        y: root.safe_top + 48px;
        width: 44px;
        height: Math.max(0px, root.height - root.safe_top - 48px);

        tap_slop: 8px;
        axis_ratio: 0.9;
        vertical_enabled: false;

        tap(x, y) => { }

        pan_started(axis) => {
            root.right_edge_active = true;
            root.right_edge_dx = 0px;
        }
        pan_moved(dx, dy) => {
            if (dx < 0px) { root.right_edge_dx = dx; }
        }
        pan_finished(dx, dy, vx, vy) => {
            root.right_edge_active = false;
            root.right_edge_dx = 0px;
            if (dx < -25px || (vx / 1px) < -1.5) {
                root.back_clicked();
            }
        }
        pan_cancelled => {
            root.right_edge_active = false;
            root.right_edge_dx = 0px;
        }
    }

    // 跟手视觉提示
    if root.left_edge_active && root.left_edge_dx > 0px : Rectangle {
        x: 0px;
        y: 0px;
        width: Math.min(root.left_edge_dx * 0.4, 28px);
        height: root.height;
        background: Theme.primary.transparentize(70%);
    }

    if root.right_edge_active && root.right_edge_dx < 0px : Rectangle {
        x: root.width - Math.min(-root.right_edge_dx * 0.4, 28px);
        y: 0px;
        width: Math.min(-root.right_edge_dx * 0.4, 28px);
        height: root.height;
        background: Theme.primary.transparentize(70%);
    }
}
