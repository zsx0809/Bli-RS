// ==============================================================================
// 视频详情与二级播放页面 (Video Detail & Player View)
//
// ==============================================================================
// 交互
// ==============================================================================
//
// 1. 点击一律用 GestureArea，不用 TouchArea。
//    TouchArea.clicked 不判位移，右滑会被翻译成点击（见 ui/gesture.slint）。
//
// 2. 左边缘返回归 App，不归系统。
//    Rust 侧全程保持 setSystemGestureExclusionRects，边缘区归 EdgeBack。
//
// 3. 滚动自管，不叠 Flickable。
//    content_layer.y = -scroll_y，跟手即时。
//
// 4. 横向滑动切换「简介 / 评论」。
//    内容层跟着手指走（tab_dx），松手按位移或甩速决定切换还是回弹。
//    这是详情页唯一的横向语义 —— 详情页不存在"切视频"的横滑。
//
// 5. Tab 栏固定在播放器下方，不随内容滚动。
//    早期把它塞进 content_layer，结果一滚动就看不见，想切 Tab 得先滚回顶部。
//
// 6. 底部系统手势条让给系统。
//    GestureArea 的 respect_system_gesture（默认开）会忽略落在底部
//    UiMetrics.system_bottom_guard 高度内的起手，避免"想切后台却滚了列表"。
//
// ==============================================================================
// 坐标（见 ui/gesture.slint 的完整推演）
// ==============================================================================
//
// GestureArea 发出的 dx / dy 已经是**窗口绝对坐标**下的位移，
// 所以内容和手指 1:1 跟随时不会产生正反馈。
// 这里绝不要拿 mouse-x / mouse-y 自己算位移。
// ==============================================================================

import { Theme, Spacing, VideoDetailData, RelatedVideoData, CommentItemData } from "../theme.slint";
import {
    IconBase,
    IconBack, IconLike, IconDislike, IconCoin, IconStar, IconShare,
    IconChevronDown, IconChevronUp, IconPlay, IconDanmaku
} from "../components/icons.slint";
import { RelatedVideoCard } from "../components/related_card.slint";
import { GestureArea, PanAxis } from "../gesture.slint";

export component VideoDetailView inherits Rectangle {
    in property <VideoDetailData> detail;
    in property <[RelatedVideoData]> related_list;
    in property <[CommentItemData]> comments: [];
    in property <length> safe_top: 0px;
    in property <length> safe_bottom: 0px;

    in-out property <bool> desc_expanded: false;
    in-out property <int> active_tab: 0;
    in-out property <bool> is_following: false;

    // 诊断日志相关属性与回调
    in property <string> log_text: "";
    in-out property <bool> show_log_dialog: false;
    callback refresh_log_clicked();
    callback clear_log_clicked();

    callback back_clicked();
    callback like_clicked();
    callback dislike_clicked();
    callback coin_clicked();
    callback fav_clicked();
    callback share_clicked();
    callback follow_clicked();
    callback related_selected(string);
    /// 点击某条评论的「回复」。参数：被回复者昵称、该评论时间（作为定位标识）。
    /// 评论输入面板尚未实现，这里只做接口预留与日志。
    callback reply_clicked(string, string);

    // 详情页根背景必须透明：整个组件是 100% 铺满 AppWindow 的，
    // 如果这里填不透明色，播放区的视频（下层 SurfaceView）就看不见了。
    // 需要实底的部分（Tab 栏 / 内容区 / 状态栏占位）各自单独填色。
    background: transparent;

    // ----------------------------------------------------------------------
    // 播放区几何
    //
    // 上一版曾把返回键/日志按钮挪到视频**上方**单独一条控制条，理由是
    // "视频层盖住一切，浮层画不出来"。那个理由在当时的实现下成立，但
    // 那个实现本身是错的 —— 它把 SurfaceView 顶到 z=0 去了。
    //
    // 现在架构反过来了（见 src/video_surface.rs 的长注释）：
    //   · 视频 SurfaceView 留在下层 z=-2
    //   · Slint 窗口表面是 TRANSLUCENT，整层透明地盖在最上面
    // 于是播放区里可以**正常画任何东西**，透明处直接透出视频。
    //
    // 所以播放区恢复成"从头到底一整块"，浮层控件全都叠在里面，
    // 和 PiliPlus / B 站客户端的视觉一致。
    // ----------------------------------------------------------------------

    // 播放器动态高度：竖屏 45% 视口（自适应高度，绝不过度压盖 UI），横屏 16:9
    out property <length> player_height: root.detail.is_vertical
        ? Math.min(Math.max(220px, (root.height - root.safe_top) * 0.45), 380px)
        : (root.width * 9 / 16);

    property <length> tabbar_h: 46px;

    // ----------------------------------------------------------------------
    // 播放器交互状态（浮层控制条 + 手势反馈）
    //
    // 全部是纯 UI 状态，先让交互跑通、可看、可测；
    // 真正的 seek / 调亮度 / 调音量由 Rust 侧接回调实现（见文件底部 callback）。
    // ----------------------------------------------------------------------
    in-out property <bool> controls_visible: true;

    /// 已加载好但还没起播（自动播放关闭时的状态）。
    /// 由 Rust 侧在拿到播放地址后置 true；用户点播放后置 false。
    in-out property <bool> awaiting_play: false;

    /// 是否处于暂停状态（用于把播放键画成三角/双竖线）
    in property <bool> paused: false;

    /// 手势中的浮层提示：none / brightness / volume / seek
    in-out property <string> hud_mode: "";

    /// 0.0 ~ 1.0
    in-out property <float> brightness: 1.0;
    /// 0.0 ~ 1.0
    in-out property <float> volume: 0.6;

    /// 进度：0.0 ~ 1.0。由 Rust 侧根据解码 PTS 持续回填（见 changed progress）。
    in-out property <float> progress: 0.0;
    /// 拖动进度时的预览值（负数表示不在拖动）
    in-out property <float> seek_preview: -1.0;

    /// 时长文案
    in property <string> time_total: "00:00";
    in property <string> time_current: "00:00";

    property <float> hud_value: root.hud_mode == "brightness" ? root.brightness
        : root.hud_mode == "volume" ? root.volume
        : 0.0;

    callback seek_to(float);
    /// 相对跳转（秒）。正数快进，负数快退。快捷键用 ±10 秒。
    callback seek_by(float);
    callback set_brightness(float);
    callback set_volume(float);
    callback toggle_play();

    // 手势起点快照（避免累积误差）
    property <float> gesture_base_value: 0.0;
    property <float> gesture_base_progress: 0.0;

    // 控制条自动隐藏
    controls_timer := Timer {
        interval: 4s;
        running: root.controls_visible && root.hud_mode == "" && root.detail.is_ready;
        triggered => { root.controls_visible = false; }
    }

    // ----------------------------------------------------------------------
    // 滚动状态
    // ----------------------------------------------------------------------
    property <length> scroll_y: 0px;
    property <length> drag_base: 0px;
    property <length> fling_vel: 0px;

    // ----------------------------------------------------------------------
    // 横向切 Tab 状态
    // ----------------------------------------------------------------------
    property <length> tab_dx: 0px;
    property <bool> tab_animating: false;
    property <PanAxis> active_axis: PanAxis.None;

    // 评论区保底测算高度（杜绝动态多行长评在测量阶段塌缩为单行导致 max_scroll 判定为 0 划不动）
    property <length> comments_measured_h: Math.max(
        root.comments.length * 110px,
        body.preferred-height
    );
    out property <length> content_h: root.active_tab == 0
        ? body.preferred-height
        : Math.max(root.comments_measured_h, body.preferred-height);
    out property <length> viewport_h: root.height - root.safe_top - root.player_height - root.tabbar_h - root.safe_bottom;
    out property <length> max_scroll: Math.max(0px, root.content_h - root.viewport_h);

    fling_timer := Timer {
        interval: 8ms;
        running: false;
        triggered => {
            if (Math.abs(root.fling_vel) < 0.4px) {
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            let next = root.scroll_y + root.fling_vel;
            if (next <= 0px) {
                root.scroll_y = 0px;
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            if (next >= root.max_scroll) {
                root.scroll_y = root.max_scroll;
                root.fling_vel = 0px;
                self.running = false;
                return;
            }
            root.scroll_y = next;
            root.fling_vel = root.fling_vel * 0.965;
        }
    }

    // ----------------------------------------------------------------------
    // 统一的 pan 状态机
    //
    // 所有 GestureArea（底层滚动层、相关视频卡片）都回调到这里，
    // 保证同一时刻只有一套状态在写 scroll_y / tab_dx。
    // ----------------------------------------------------------------------
    function pan_begin(axis: PanAxis) {
        root.active_axis = axis;
        fling_timer.stop();
        root.fling_vel = 0px;
        root.tab_animating = false;

        if (axis == PanAxis.Vertical) {
            root.drag_base = root.scroll_y;
        }
    }

    function pan_move(dx: length, dy: length) {
        if (root.active_axis == PanAxis.Vertical) {
            root.scroll_y = Math.max(0px, Math.min(root.max_scroll, root.drag_base - dy));
        } else if (root.active_axis == PanAxis.Horizontal) {
            // 到头了还继续往外拖 → 30% 阻尼（"墙"）
            let at_left = (root.active_tab == 0 && dx > 0px);
            let at_right = (root.active_tab == 1 && dx < 0px);
            root.tab_dx = (at_left || at_right) ? dx * 0.3 : dx;
        }
    }

    function pan_end(dx: length, dy: length, vx: length, vy: length) {
        if (root.active_axis == PanAxis.Vertical) {
            let v = -vy;
            let scaled_v = v * 1.6;
            if ((v / 1px) > 1.2) {
                root.fling_vel = Math.min(scaled_v, 75px);
                fling_timer.start();
            } else if ((v / 1px) < -1.2) {
                root.fling_vel = Math.max(scaled_v, -75px);
                fling_timer.start();
            }
        } else if (root.active_axis == PanAxis.Horizontal) {
            // 针对 120Hz 高刷新率调优：boost 适度放大，轻甩即可平滑切换「简介/评论」Tab
            let threshold = root.width * 0.18;
            let boost = (vx / 1px) * 22px;
            let effective = root.tab_dx + boost;

            let go_comment = (effective < -threshold && root.active_tab == 0);
            let go_intro = (effective > threshold && root.active_tab == 1);

            if (go_comment || go_intro) {
                root.active_tab = go_comment ? 1 : 0;
                root.scroll_y = 0px;
                root.tab_dx = 0px;
                root.fling_vel = 0px;
            } else {
                // 回弹
                root.tab_animating = true;
                root.tab_dx = 0px;
            }
        }
        root.active_axis = PanAxis.None;
    }

    function pan_cancel() {
        root.fling_vel = 0px;
        root.tab_animating = true;
        root.tab_dx = 0px;
        root.active_axis = PanAxis.None;
    }

    // ----------------------------------------------------------------------
    // 左右双向边缘侧滑返回状态
    // ----------------------------------------------------------------------
    property <length> left_edge_dx: 0px;
    property <bool> left_edge_active: false;
    property <length> right_edge_dx: 0px;
    property <bool> right_edge_active: false;

    // 顶部状态栏安全占位，留出手机顶部状态栏空间
    status_bar_spacer := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.safe_top;
        background: #000000;
    }

    // ----------------------------------------------------------------------
    // 顶部播放视口（浮层容器）
    //
    // 图层顺序（关键，别改乱）：
    //   下面 = SurfaceView（MediaCodec 零拷贝输出，z=-2）
    //   上面 = 这一个 Rectangle 及其全部子元素（Slint 透明窗口层）
    //
    // 所以这里的 background 必须是 **transparent**：
    //   填黑色会把视频整个挡住，表现就是"解码成功、首帧已送显，屏幕全黑"。
    //   需要黑底时由下层 windowBackground（@android:color/black）提供。
    //
    // 因为 UI 在最上层，播放区内可以自由绘制：
    //   封面占位、加载态、错误态、返回键、日志、以及后续的控制条 /
    //   亮度音量指示 / 快进快退反馈 / 全屏按钮。
    // ----------------------------------------------------------------------
    player_box := Rectangle {
        x: 0px;
        y: root.safe_top;
        width: root.width;
        height: root.player_height;
        background: transparent;
        clip: true;

        Image {
            source: root.detail.cover;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.detail.is_ready ? 0 : 1;
            animate opacity { duration: 240ms; }
        }

        // ==================================================================
        // 播放手势层
        //
        // 整块播放区都能起手，判定规则（与 B 站 / PiliPlus 一致）：
        //   轻触          → 切换控制条显隐
        //   左半屏纵滑    → 亮度（向上增亮）
        //   右半屏纵滑    → 音量（向上增大）
        //   任意横向滑    → 快进 / 快退
        //
        // 之所以能这么做，是因为 Slint 的 UI 层现在**在视频之上**：
        // SurfaceView 默认不消费触摸事件，事件照常落到这一层。
        // ==================================================================
        player_gesture := GestureArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            tap_slop: 6px;
            axis_ratio: 1.0;
            // 播放区不是列表，底部保护会让下缘手势失效，这里关掉
            respect_system_gesture: false;

            tap(x, y) => {
                root.controls_visible = !root.controls_visible;
                if (root.controls_visible) {
                    controls_timer.restart();
                }
            }

            pan_started(axis) => {
                root.gesture_base_value = 0.0;
                root.gesture_base_progress = root.progress;
            }

            pan_moved(dx, dy) => {
                let vw = parent.width / 1px;
                let vh = parent.height / 1px;

                if (self.current_axis == PanAxis.Horizontal) {
                    // 横向：快进快退，整条播放区宽度 = 全片时长
                    if (root.hud_mode != "seek") {
                        root.hud_mode = "seek";
                        root.controls_visible = true;
                    }
                    let delta = (dx / 1px) / vw;
                    let np = Math.max(0.0, Math.min(1.0, root.gesture_base_progress + delta));
                    root.seek_preview = np;
                } else if (self.current_axis == PanAxis.Vertical) {
                    // 纵向：左半边亮度，右半边音量。改动量按高度归一化
                    let is_left = (self.origin_x / 1px) < vw / 2;
                    if (root.hud_mode == "" || root.hud_mode == "seek") {
                        root.hud_mode = is_left ? "brightness" : "volume";
                        root.gesture_base_value = is_left ? root.brightness : root.volume;
                    }
                    // 向上为增加：dy 为负 → 增值
                    let delta = -(dy / 1px) / vh * 1.4;
                    let base = root.gesture_base_value;
                    let nv = Math.max(0.0, Math.min(1.0, base + delta));
                    if (root.hud_mode == "brightness") {
                        root.brightness = nv;
                        root.set_brightness(nv);
                    } else {
                        root.volume = nv;
                        root.set_volume(nv);
                    }
                }
            }

            pan_finished(dx, dy, vx, vy) => {
                if (root.hud_mode == "seek" && root.seek_preview >= 0.0) {
                    root.progress = root.seek_preview;
                    root.seek_to(root.seek_preview);
                }
                root.seek_preview = -1.0;
                root.hud_mode = "";
                controls_timer.restart();
            }

            pan_cancelled => {
                root.seek_preview = -1.0;
                root.hud_mode = "";
            }
        }

        // ==================================================================
        // 手势 HUD：亮度 / 音量 / 进度
        //
        // 画在正中偏上，半透明圆角块，1.2 秒后随 hud_mode 清空自动消失。
        // ==================================================================
        if root.hud_mode != "" : Rectangle {
            width: 176px;
            height: 74px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 24px;
            background: #000000cc;
            border-radius: 14px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.hud_mode == "brightness" ? "亮度"
                        : root.hud_mode == "volume" ? "音量"
                        : "进度";
                    color: #ffffffcc;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                // 进度条 / 竖直指示
                Rectangle {
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff33;

                    Rectangle {
                        width: parent.width * (root.hud_mode == "seek"
                            ? (root.seek_preview >= 0.0 ? root.seek_preview : root.progress)
                            : root.hud_value);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.primary;
                    }
                }

                // 百分比：三种 HUD 都显示，亮度/音量也给出精确数值
                // （没有系统音量条了，用户只能靠这个数字判断）
                Text {
                    text: root.hud_mode == "seek"
                        ? (Math.round((root.seek_preview >= 0.0
                            ? root.seek_preview
                            : root.progress) * 100) + "%")
                        : (Math.round(root.hud_value * 100) + "%");
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }

        // ==================================================================
        // 中央播放按钮（自动播放关闭时出现）
        //
        // 这是"进详情页只加载、不播放"的起播入口：
        //   有它，用户明确知道"点这里才开始播"，而不是对着一块黑猜。
        // ==================================================================
        if root.awaiting_play : Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #00000099;

            Text {
                text: "▶";
                color: #ffffff;
                font-size: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.awaiting_play = false;
                    root.toggle_play();
                }
            }
        }

        // ==================================================================
        // 浮层控制条 —— 极简风格（参考 PiliPlus / B 站客户端）
        //
        // 设计取向：**越少越好**。
        //   上：返回键 + 一排功能图标，压在顶部渐变蒙版上
        //   下：进度条贴着画面下缘，其下是「时间 · 播放 · 时长」
        //   中间大面积留给视频本身，不放任何常驻控件
        //
        // 为什么不用厚黑底块：
        //   之前是 78px 高的 #000000a8 实心条，把画面下缘吃掉一整块，
        //   竖屏视频本来就矮，再扣掉就更憋屈。现在改成渐隐蒙版，
        //   视觉上只压暗、不遮挡，视频仍是主角。
        // ==================================================================
        if root.controls_visible && root.detail.load_error == "" : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;

            // ---- 顶部蒙版：从上到下渐隐，托住返回键与图标 ----
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 56px;
                background: @linear-gradient(180deg, #000000cc 0%, #00000000 100%);
            }

            // ---- 底部蒙版：从下到上渐隐，托住进度条与时间 ----
            Rectangle {
                x: 0px;
                y: parent.height - 76px;
                width: parent.width;
                height: 76px;
                background: @linear-gradient(0deg, #000000cc 0%, #00000000 100%);
            }

            // ---- 返回键 ----
            back_btn := GestureArea {
                x: 4px;
                y: 6px;
                width: 44px;
                height: 44px;

                tap(x, y) => { root.back_clicked(); }

                IconBack {
                    x: 10px;
                    y: 10px;
                    size: 24px;
                    tint: #ffffff;
                    stroke_w: 2px;
                }
            }

            // ---- 右侧功能图标：日志 ----
            //
            // 只放一个。播放设置、投屏这些还没做，占位图标点不了是欺骗，
            // 等真做了再加。
            log_btn := GestureArea {
                x: parent.width - self.width - 8px;
                y: 6px;
                width: 44px;
                height: 44px;

                tap(x, y) => {
                    root.show_log_dialog = !root.show_log_dialog;
                    if (root.show_log_dialog) {
                        root.refresh_log_clicked();
                    }
                }

                // 三横线（"日志列表"意象），比"日志"两个字更轻
                IconBase {
                    x: 10px;
                    y: 10px;
                    size: 24px;
                    tint: #ffffff;
                    stroke_w: 2px;
                    commands: "M 4 7 L 20 7 M 4 12 L 20 12 M 4 17 L 20 17";
                }
            }

            // ---- 进度条：贴着画面底缘，无内边距 ----
            progress_bar := GestureArea {
                property <float> bar_frac: root.seek_preview >= 0.0 ? root.seek_preview : root.progress;
                x: 0px;
                y: parent.height - 38px;
                width: parent.width;
                height: 18px;
                tap_slop: 3px;
                axis_ratio: 2.0;
                vertical_enabled: false;
                respect_system_gesture: false;

                // 进度条左右各留 0：和视频边缘齐平，
                // 这是 PiliPlus 的观感来源之一 —— 通长的细线。
                tap(px, py) => {
                    let frac = Math.max(0.0, Math.min(1.0, (px / 1px) / (self.width / 1px)));
                    root.progress = frac;
                    root.seek_to(frac);
                }

                pan_started(axis) => {
                    root.gesture_base_progress = root.progress;
                    root.hud_mode = "seek";
                }
                pan_moved(dx, dy) => {
                    let base = Math.max(0.0, Math.min(1.0,
                        root.gesture_base_progress + (dx / 1px) / (self.width / 1px)));
                    root.seek_preview = base;
                }
                pan_finished(dx, dy, vx, vy) => {
                    if (root.seek_preview >= 0.0) {
                        root.progress = root.seek_preview;
                        root.seek_to(root.seek_preview);
                    }
                    root.seek_preview = -1.0;
                    root.hud_mode = "";
                }
                pan_cancelled => {
                    root.seek_preview = -1.0;
                    root.hud_mode = "";
                }

                // 轨道：2px 细线，半透明白
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    width: parent.width;
                    height: 2px;
                    background: #ffffff44;

                    Rectangle {
                        width: parent.width * progress_bar.bar_frac;
                        height: parent.height;
                        background: #ffffff;
                    }
                }

                // 手柄：小圆点，拖动时出现
                Rectangle {
                    x: parent.width * progress_bar.bar_frac - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.hud_mode == "seek" ? 10px : 0px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #ffffff;
                }
            }

            // ---- 操作按钮行：快退 / 播放 / 快进 ----
            //
            // 位置与尺寸都改过（第二版）：
            //   上一版把三个按钮塞在进度条右侧一簇，每个只有 40x24。
            //   实测结果是"快退能点到、播放能点到、快进点不到"——
            //   因为那一簇贴着屏幕右边缘，最右侧的按钮有相当一部分
            //   落在系统边缘手势区里，触摸被系统吃掉。
            //
            //   现在改成：
            //     · 整行**横向居中、等距铺开**，三个按钮各自远离屏幕边缘
            //     · 每个按钮 64x52 的大命中区（远超 48dp 最小触控尺寸）
            //     · 整体放在**进度条上方**，不与进度条的拖动区重叠
            //
            //   反正播放几秒后整个控制层都会隐藏，占这点位置完全没问题，
            //   换来的是"闭着眼也能点中"。
            HorizontalLayout {
                x: 0px;
                y: parent.height - 96px;
                width: parent.width;
                height: 52px;
                alignment: center;

                // ---- 后退 10 秒 ----
                back10_btn := GestureArea {
                    width: 64px;
                    height: 52px;

                    tap(x, y) => { root.seek_by(-10.0); }

                    IconBase {
                        x: (parent.width - 26px) / 2;
                        y: (parent.height - 26px) / 2;
                        size: 26px;
                        tint: back10_btn.pressed ? #ffffffaa : #ffffff;
                        stroke_w: 1.8px;
                        commands: "M 12 5 A 7.5 7.5 0 1 0 19 12 M 12 5 L 12 9 M 12 5 L 8.2 8.5";
                    }
                }

                Rectangle { width: 20px; background: transparent; }

                // ---- 播放 / 暂停 ----
                play_btn := GestureArea {
                    width: 64px;
                    height: 52px;

                    tap(x, y) => { root.toggle_play(); }

                    IconBase {
                        x: (parent.width - 28px) / 2;
                        y: (parent.height - 28px) / 2;
                        size: 28px;
                        tint: play_btn.pressed ? #ffffffaa : #ffffff;
                        fill_mode: true;
                        stroke_w: 0px;
                        commands: root.paused
                            ? "M 4.5 2.5 L 14.5 8 L 4.5 13.5 Z"
                            : "M 4.5 2.5 L 7.5 2.5 L 7.5 13.5 L 4.5 13.5 Z M 10.5 2.5 L 13.5 2.5 L 13.5 13.5 L 10.5 13.5 Z";
                    }
                }

                Rectangle { width: 20px; background: transparent; }

                // ---- 前进 10 秒 ----
                fwd10_btn := GestureArea {
                    width: 64px;
                    height: 52px;

                    tap(x, y) => { root.seek_by(10.0); }

                    IconBase {
                        x: (parent.width - 26px) / 2;
                        y: (parent.height - 26px) / 2;
                        size: 26px;
                        tint: fwd10_btn.pressed ? #ffffffaa : #ffffff;
                        stroke_w: 1.8px;
                        commands: "M 12 5 A 7.5 7.5 0 1 1 5 12 M 12 5 L 12 9 M 12 5 L 15.8 8.5";
                    }
                }
            }

            // ---- 时间行：贴在进度条上方 ----
            Text {
                x: 12px;
                y: parent.height - 40px;
                text: root.time_current + " / " + root.time_total;
                color: #ffffff;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

    }

    // ----------------------------------------------------------------------
    // Sub-Tab 栏（固定，不随内容滚动）
    // ----------------------------------------------------------------------
    Rectangle {
        x: 0px;
        y: root.safe_top + root.player_height;
        width: 100%;
        height: root.tabbar_h;
        background: Theme.background;

        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.outline_variant.transparentize(60%);
        }

        HorizontalLayout {
            padding-left: Spacing.page_margin;
            padding-right: Spacing.page_margin;
            alignment: space-between;

            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                intro_tab := GestureArea {
                    width: 60px;
                    height: root.tabbar_h;
                    tap(x, y) => {
                        root.active_tab = 0;
                        root.scroll_y = 0px;
                        root.tab_dx = 0px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;

                        Text {
                            text: "简介";
                            font-size: 14px;
                            font-weight: root.active_tab == 0 ? 700 : 500;
                            color: root.active_tab == 0 ? Theme.primary : Theme.on_surface_variant;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 2px;
                            background: root.active_tab == 0 ? Theme.primary : transparent;
                            border-radius: 1px;
                            animate background { duration: Theme.animation_duration_fast; }
                        }
                    }
                }

                comment_tab := GestureArea {
                    width: 84px;
                    height: root.tabbar_h;
                    tap(x, y) => {
                        root.active_tab = 1;
                        root.scroll_y = 0px;
                        root.tab_dx = 0px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;

                        Text {
                            text: root.comments.length > 0
                                ? "评论 " + root.comments.length
                                : "评论";
                            font-size: 14px;
                            font-weight: root.active_tab == 1 ? 700 : 500;
                            color: root.active_tab == 1 ? Theme.primary : Theme.on_surface_variant;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 2px;
                            background: root.active_tab == 1 ? Theme.primary : transparent;
                            border-radius: 1px;
                            animate background { duration: Theme.animation_duration_fast; }
                        }
                    }
                }
            }

            Rectangle {
                width: 110px;
                height: 28px;
                border-radius: 14px;
                background: Theme.surface_variant;
                y: 9px;

                Text {
                    text: "点我发弹幕";
                    color: Theme.on_surface_variant;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ----------------------------------------------------------------------
    // 内容区（自适应剩余视口高度）
    // ----------------------------------------------------------------------
    scroll_clip := Rectangle {
        x: 0px;
        y: root.safe_top + root.player_height + root.tabbar_h;
        width: root.width;
        height: Math.max(0px, root.viewport_h);
        clip: true;
        background: Theme.background;

        // 底层手势：纵向滚动 + 横向切 Tab (简介 <-> 评论)
        scroll_gesture := GestureArea {
            width: 100%;
            height: 100%;
            tap_slop: 8px;
            axis_ratio: 1.1;

            pan_started(axis) => { root.pan_begin(axis); }
            pan_moved(dx, dy) => { root.pan_move(dx, dy); }
            pan_finished(dx, dy, vx, vy) => { root.pan_end(dx, dy, vx, vy); }
            pan_cancelled => { root.pan_cancel(); }
        }

        content_layer := Rectangle {
            width: parent.width;
            height: Math.max(parent.height, root.content_h);
            y: -root.scroll_y;
            x: root.tab_dx;

            animate x {
                duration: root.tab_animating ? Theme.animation_duration_normal : 0ms;
                easing: ease-out;
            }

            body := VerticalLayout {
                width: parent.width;
                padding: 0px;
                spacing: 0px;
                alignment: start;

                // ================= 简介 Tab =================
                if root.active_tab == 0 : VerticalLayout {
                    spacing: 0px;

                    // ---- UP 主 ----
                    Rectangle {
                        height: 60px;
                        width: 100%;

                        HorizontalLayout {
                            padding-left: Spacing.page_margin;
                            padding-right: Spacing.page_margin;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: Theme.surface_variant;
                                    clip: true;
                                    y: 10px;

                                    Image {
                                        source: root.detail.author_face;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }

                                    if root.detail.author_face.width == 0 : Text {
                                        text: "UP";
                                        color: Theme.outline;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: root.detail.author;
                                        color: Theme.on_surface;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }

                                    // 粉丝数 · 投稿数
                                    //
                                    // 原来这里是硬编码的"UP主 · 优质创作者" ——
                                    // 那个「优质创作者」标签其实来自认证信息，
                                    // 绝大多数 UP 主并没有，属于无意义文案。
                                    // 换成真实数据：粉丝数与已发布视频数，
                                    // 这才对用户有判断价值（判断这号值不值得关注）。
                                    //
                                    // 两者任一为空就自动省略，不显示孤立的分隔点。
                                    Text {
                                        text: root.detail.up_fans == "" && root.detail.up_videos == ""
                                            ? ""
                                            : (root.detail.up_fans == ""
                                                ? root.detail.up_videos
                                                : (root.detail.up_videos == ""
                                                    ? root.detail.up_fans
                                                    : root.detail.up_fans + " · " + root.detail.up_videos));
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                    }
                                }
                            }

                            follow_btn := GestureArea {
                                width: root.is_following ? 64px : 72px;
                                height: 30px;
                                y: 15px;

                                tap(x, y) => {
                                    root.is_following = !root.is_following;
                                    root.follow_clicked();
                                }

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 15px;
                                    background: root.is_following ? Theme.surface_variant : Theme.bili_pink;

                                    Text {
                                        text: root.is_following ? "已关注" : "+ 关注";
                                        color: root.is_following ? Theme.on_surface_variant : #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ---- 标题与简介 ----
                    VerticalLayout {
                        padding-left: Spacing.page_margin;
                        padding-right: Spacing.page_margin;
                        padding-top: 4px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        title_hit := GestureArea {
                            width: 100%;
                            height: title_row.preferred-height;

                            tap(x, y) => { root.desc_expanded = !root.desc_expanded; }

                            title_row := HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: root.detail.title;
                                    color: Theme.on_surface;
                                    font-size: 15px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    max-lines: root.desc_expanded ? 10 : 2;
                                    overflow: elide;
                                    width: root.width - 56px;
                                }

                                VerticalLayout {
                                    alignment: start;
                                    y: 2px;

                                    if !root.desc_expanded : IconChevronDown {
                                        size: 20px;
                                        tint: Theme.on_surface_variant;
                                    }
                                    if root.desc_expanded : IconChevronUp {
                                        size: 20px;
                                        tint: Theme.on_surface_variant;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 3px;
                                IconPlay { size: 10px; tint: Theme.on_surface_variant; y: 2px; }
                                Text { text: root.detail.views; color: Theme.on_surface_variant; font-size: 11px; }
                            }

                            HorizontalLayout {
                                spacing: 3px;
                                IconDanmaku { size: 10px; tint: Theme.on_surface_variant; y: 2px; }
                                Text { text: root.detail.danmaku; color: Theme.on_surface_variant; font-size: 11px; }
                            }

                            Text {
                                text: root.detail.pubdate;
                                color: Theme.on_surface_variant;
                                font-size: 11px;
                            }
                        }

                        if root.desc_expanded : Text {
                            text: root.detail.desc != "" ? root.detail.desc : "暂无简介";
                            color: Theme.on_surface_variant;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // ---- 五联条 ----
                    Rectangle {
                        height: 62px;
                        width: 100%;

                        HorizontalLayout {
                            padding-left: Spacing.page_margin;
                            padding-right: Spacing.page_margin;
                            alignment: space-around;

                            like_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.like_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconLike {
                                        size: 22px;
                                        tint: root.detail.is_liked ? Theme.bili_pink : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_liked;
                                    }
                                    Text {
                                        text: root.detail.likes;
                                        color: root.detail.is_liked ? Theme.bili_pink : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            dislike_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.dislike_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconDislike { size: 22px; tint: Theme.on_surface_variant; }
                                    Text {
                                        text: "不喜欢";
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            coin_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.coin_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconCoin {
                                        size: 22px;
                                        tint: root.detail.is_coined ? Theme.bili_coin : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_coined;
                                    }
                                    Text {
                                        text: root.detail.coins;
                                        color: root.detail.is_coined ? Theme.bili_coin : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            fav_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.fav_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconStar {
                                        size: 22px;
                                        tint: root.detail.is_favorited ? Theme.bili_fav : Theme.on_surface_variant;
                                        fill_mode: root.detail.is_favorited;
                                    }
                                    Text {
                                        text: root.detail.favorites;
                                        color: root.detail.is_favorited ? Theme.bili_fav : Theme.on_surface_variant;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            share_btn := GestureArea {
                                width: 56px;
                                height: 62px;
                                tap(x, y) => { root.share_clicked(); }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    IconShare { size: 22px; tint: Theme.on_surface_variant; }
                                    Text {
                                        text: root.detail.shares;
                                        color: Theme.on_surface_variant;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 1px;
                        background: Theme.outline_variant.transparentize(70%);
                    }

                    // ---- 相关推荐 ----
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 40px;
                        spacing: 4px;

                        // 卡片自带 GestureArea：纵向滚、横向切 Tab 都冒泡上来，
                        // 保证压在卡片上的手势和压在空隙上的行为完全一致。
                        for item in root.related_list : RelatedVideoCard {
                            data: item;
                            clicked => { root.related_selected(item.bvid); }
                            pan_started(axis) => { root.pan_begin(axis); }
                            pan_moved(dx, dy) => { root.pan_move(dx, dy); }
                            pan_finished(dx, dy, vx, vy) => { root.pan_end(dx, dy, vx, vy); }
                            pan_cancelled => { root.pan_cancel(); }
                        }
                    }
                }

                // ================= 评论 Tab =================
                //
                // 排版目标（对着 PiliPlus / 官方客户端）：
                //   正文 15px、昵称 13px、元信息 11px、条目间距 22px + 分割线。
                // 之前是 13 / 12 / 10 + 16px 间距，字小且挤，读起来费劲。
                if root.active_tab == 1 : VerticalLayout {
                    padding-left: Spacing.page_margin + 2px;
                    padding-right: Spacing.page_margin + 2px;
                    padding-top: 14px;
                    padding-bottom: 48px;
                    spacing: 0px;

                    if root.comments.length == 0 : Rectangle {
                        height: 140px;

                        Text {
                            text: "评论加载中…";
                            color: Theme.on_surface_variant;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for comment in root.comments : VerticalLayout {
                        spacing: 0px;

                        // 每条评论独立的楼中楼展开状态。
                        //
                        // 为什么放在循环体内：Slint 的 for 每次迭代有自己的
                        // 实例作用域，property 天然是"每条一个"，不需要
                        // 用数组去手动维护展开集合。
                        property <bool> expanded: false;

                        Rectangle {
                            height: c_item.preferred-height;
                            width: 100%;

                            // 评论手势区：向 root 转发 pan 手势，确保垂直滑动与横切 Tab 顺滑响应
                            GestureArea {
                                width: 100%;
                                height: 100%;
                                tap_slop: 8px;
                                axis_ratio: 1.1;

                                pan_started(axis) => { root.pan_begin(axis); }
                                pan_moved(dx, dy) => { root.pan_move(dx, dy); }
                                pan_finished(dx, dy, vx, vy) => { root.pan_end(dx, dy, vx, vy); }
                                pan_cancelled => { root.pan_cancel(); }
                            }

                            c_item := VerticalLayout {
                                spacing: 0px;
                                padding-bottom: 18px;
                                padding-top: 2px;

                                HorizontalLayout {
                                    spacing: 12px;

                                    // 头像
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: Theme.surface_variant;
                                        clip: true;

                                        Image {
                                            source: comment.user_face;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }

                                    // 右侧自然横向拉伸撑满
                                    VerticalLayout {
                                        spacing: 7px;

                                        // ---- 昵称行：昵称 + LV 徽章 + UP 标 ----
                                        HorizontalLayout {
                                            spacing: 5px;
                                            alignment: start;

                                            Text {
                                                // 大会员昵称染成 B 站粉
                                                text: comment.user_name;
                                                color: comment.is_vip
                                                    ? #ff6699
                                                    : Theme.on_surface_variant;
                                                font-size: 13px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }

                                            // LV 徽章
                                            if comment.level > 0 : Rectangle {
                                                width: lv_txt.preferred-width + 8px;
                                                height: 13px;
                                                border-radius: 2px;
                                                y: (parent.height - self.height) / 2;
                                                background: comment.level >= 6
                                                    ? #ff4040
                                                    : comment.level >= 3
                                                        ? #ff9a00
                                                        : #999999;

                                                lv_txt := Text {
                                                    text: "LV" + (comment.level);
                                                    color: #ffffff;
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            // UP 标
                                            if comment.is_up : Rectangle {
                                                width: up_txt.preferred-width + 8px;
                                                height: 13px;
                                                border-radius: 2px;
                                                y: (parent.height - self.height) / 2;
                                                background: #fb7299;

                                                up_txt := Text {
                                                    text: "UP";
                                                    color: #ffffff;
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }

                                        // ---- 正文 ----
                                        Text {
                                            text: comment.content;
                                            color: Theme.on_surface;
                                            font-size: 15px;
                                            wrap: word-wrap;
                                        }

                                        // ---- 楼中楼 ----
                                        //
                                        // 接口只在顶层评论里预置前 3 条，
                                        // 点了"展开"就全显示；更深的线程
                                        // 需要额外的 detail 接口，暂不请求。
                                        if comment.sub_replies.length > 0 : Rectangle {
                                            width: 100%;
                                            background: Theme.surface_variant.transparentize(60%);
                                            border-radius: 8px;
                                            // padding 用内层 VerticalLayout 实现
                                            height: sub_col.preferred-height;

                                            sub_col := VerticalLayout {
                                                padding: 10px;
                                                spacing: 8px;

                                                for sub_text[i] in comment.sub_replies : VerticalLayout {
                                                    spacing: 3px;

                                                    // 楼中楼默认只展开前 1 条，除非点了"展开"
                                                    // 折叠时只露第一条（和 B 站一致），展开时全露
                                                    if expanded || i == 0 : VerticalLayout {
                                                        spacing: 3px;

                                                        Text {
                                                            text: comment.sub_authors[i] + "：";
                                                            color: Theme.on_surface_variant;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: sub_text;
                                                            color: Theme.on_surface;
                                                            font-size: 13px;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }

                                                // 展开 / 收起
                                                //
                                                // 折叠时显示总数（bilibili 的原话术是
                                                // "共 N 条回复"，N 取自 rcount，比
                                                // 接口预置的条数更准）；展开后变成"收起"。
                                                if comment.reply_count > 1 || comment.sub_replies.length > 1 : Text {
                                                    text: expanded
                                                        ? "收起"
                                                        : "共 " + (comment.reply_count > 0
                                                            ? comment.reply_count
                                                            : comment.sub_replies.length) + " 条回复";
                                                    color: Theme.primary;
                                                    font-size: 11px;

                                                    TouchArea {
                                                        clicked => { expanded = !expanded; }
                                                    }
                                                }
                                            }
                                        }

                                        // ---- 底栏：时间 • IP属地  赞  回复 ----
                                        HorizontalLayout {
                                            spacing: 14px;
                                            alignment: start;

                                            Text {
                                                // 时间与属地拼成一行，
                                                // 和 B 站/PiliPlus 的显示一致：
                                                // "1天前 • IP属地：广东"
                                                text: comment.location == ""
                                                    ? comment.pubtime
                                                    : comment.pubtime + " • " + comment.location;
                                                color: Theme.outline;
                                                font-size: 11px;
                                            }

                                            Text {
                                                text: "赞 " + comment.likes;
                                                color: Theme.outline;
                                                font-size: 11px;
                                            }

                                            // 回复按钮
                                            reply_btn := Text {
                                                text: "回复";
                                                color: reply_btn_touch.pressed
                                                    ? Theme.primary
                                                    : Theme.outline;
                                                font-size: 11px;

                                                reply_btn_touch := TouchArea {
                                                    clicked => {
                                                        // 暂未接入评论输入面板。
                                                        // 这里先留明确的视觉反馈，
                                                        // 不假装功能已实现。
                                                        root.reply_clicked(
                                                            comment.user_name,
                                                            comment.pubtime);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 14px;
                                }

                                // 分割线：条目之间靠它划界
                                Rectangle {
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.outline_variant.transparentize(75%);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------------
    // 左右双边缘侧滑返回（左边右滑、右边左滑均返回首页）
    // ----------------------------------------------------------------------
    left_edge_back := GestureArea {
        x: 0px;
        y: root.safe_top + 48px;
        width: 44px;
        height: Math.max(0px, root.height - root.safe_top - 48px);

        tap_slop: 8px;
        axis_ratio: 0.9;
        vertical_enabled: false;

        tap(x, y) => { }

        pan_started(axis) => {
            root.left_edge_active = true;
            root.left_edge_dx = 0px;
        }
        pan_moved(dx, dy) => {
            if (dx > 0px) { root.left_edge_dx = dx; }
        }
        pan_finished(dx, dy, vx, vy) => {
            root.left_edge_active = false;
            root.left_edge_dx = 0px;
            if (dx > 20px || (vx / 1px) > 0.8) {
                root.back_clicked();
            }
        }
        pan_cancelled => {
            root.left_edge_active = false;
            root.left_edge_dx = 0px;
        }
    }

    right_edge_back := GestureArea {
        x: root.width - 44px;
        y: root.safe_top + 48px;
        width: 44px;
        height: Math.max(0px, root.height - root.safe_top - 48px);

        tap_slop: 8px;
        axis_ratio: 0.9;
        vertical_enabled: false;

        tap(x, y) => { }

        pan_started(axis) => {
            root.right_edge_active = true;
            root.right_edge_dx = 0px;
        }
        pan_moved(dx, dy) => {
            if (dx < 0px) { root.right_edge_dx = dx; }
        }
        pan_finished(dx, dy, vx, vy) => {
            root.right_edge_active = false;
            root.right_edge_dx = 0px;
            if (dx < -20px || (vx / 1px) < -0.8) {
                root.back_clicked();
            }
        }
        pan_cancelled => {
            root.right_edge_active = false;
            root.right_edge_dx = 0px;
        }
    }

    // 跟手视觉提示
    if root.left_edge_active && root.left_edge_dx > 0px : Rectangle {
        x: 0px;
        y: 0px;
        width: Math.min(root.left_edge_dx * 0.4, 28px);
        height: root.height;
        background: Theme.primary.transparentize(70%);
    }

    if root.right_edge_active && root.right_edge_dx < 0px : Rectangle {
        x: root.width - Math.min(-root.right_edge_dx * 0.4, 28px);
        y: 0px;
        width: Math.min(-root.right_edge_dx * 0.4, 28px);
        height: root.height;
        background: Theme.primary.transparentize(70%);
    }

    // ======================================================================
    // 实时诊断日志弹层浮窗 (Log Dialog Overlay)
    // ======================================================================
    if root.show_log_dialog : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000dd;

        VerticalLayout {
            padding: 16px;
            padding-top: root.safe_top + 12px;
            padding-bottom: root.safe_bottom + 12px;
            spacing: 10px;

            // 头部标题与控制栏
            HorizontalLayout {
                height: 38px;
                alignment: space-between;

                Text {
                    text: "运行诊断日志";
                    color: #ffffff;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // 刷新
                    Rectangle {
                        width: 58px;
                        height: 30px;
                        border-radius: 6px;
                        background: Theme.surface_variant;
                        Text {
                            text: "刷新";
                            color: #ffffff;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.refresh_log_clicked(); }
                        }
                    }

                    // 清空
                    Rectangle {
                        width: 58px;
                        height: 30px;
                        border-radius: 6px;
                        background: Theme.surface_variant;
                        Text {
                            text: "清空";
                            color: #ffffff;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.clear_log_clicked(); }
                        }
                    }

                    // 关闭
                    Rectangle {
                        width: 58px;
                        height: 30px;
                        border-radius: 6px;
                        background: Theme.primary;
                        Text {
                            text: "关闭";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.show_log_dialog = false; }
                        }
                    }
                }
            }

            // 日志文本视口
            Rectangle {
                border-radius: 8px;
                background: #0d1117;
                border-width: 1px;
                border-color: #30363d;
                clip: true;

                Flickable {
                    width: 100%;
                    height: 100%;
                    content-height: log_txt.preferred-height + 32px;

                    VerticalLayout {
                        padding: 12px;
                        alignment: start;

                        log_txt := Text {
                            text: root.log_text != "" ? root.log_text : "暂无日志，请点击刷新";
                            color: #58a6ff;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
